# Aegaeon (server under test)
# For a self-signed local HTTPS setup, start from `.env.local.example` instead.
# Optional: use a pre-built image instead of a local `nix run .#docker-build` load.
# AEGAEON_IMAGE=ghcr.io/<OWNER>/<REPO>/aegaeon-server:latest
AEGAEON_DOMAIN=aegaeon.codetakt.dev
AEGAEON_PUBLIC_BASE_URL=https://aegaeon.codetakt.dev
AEGAEON_RUNTIME_ISSUER_HOST=aegaeon.codetakt.dev

# Conformance suite (RP / test tool)
SUITE_DOMAIN=suite.codetakt.dev
SUITE_PUBLIC_BASE_URL=https://suite.codetakt.dev
# Suite git ref (default: master)
SUITE_REF=master

# TLS certificate primary name (files under /etc/letsencrypt/certificates/)
# - If you use the `acme` profile in this repo (lego SAN cert for AEGAEON_DOMAIN + SUITE_DOMAIN),
#   this is typically the first domain passed to lego, i.e. AEGAEON_DOMAIN.
# - If you already have a wildcard / SAN cert keyed by the base zone, set this to e.g. `codetakt.dev`.
CERT_PRIMARY_DOMAIN=aegaeon.codetakt.dev

# nginx published ports (host)
# If you can't bind 80/443 locally, use non-privileged ports (e.g. 18080/18443) and
# include the HTTPS port in both `*_PUBLIC_BASE_URL` values.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional: override the OIDC signing kid used for ID Tokens / JWKS.
# The signing key material is mounted from the repo fixture by default; see docker-compose.oidf.yml.
AEGAEON_OIDC_SIGNING_KID=oidc-signing-1

# ACME (lego) - DNS-01
LEGO_EMAIL=you@example.com

# lego DNS provider id (Route53)
LEGO_DNS=route53

# Route53 credentials.
# Recommended: avoid long-lived access keys. Prefer short-lived STS credentials (SSO/aws-vault)
# or CI OIDC (GitHub Actions) and provide these via the environment instead of committing them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional (STS)
# AWS_SESSION_TOKEN=

# Route53 is global; `us-east-1` is a safe default for signing.
AWS_REGION=us-east-1

# Optional: if you have multiple zones with the same name.
# AWS_HOSTED_ZONE_ID=Z1234567890ABC
