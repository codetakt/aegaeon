# Local self-signed HTTPS setup for OIDF development.
# Copy to `.env.local`, then run:
#   OIDF_ENV_FILE=scripts/oidf_conformance/.env.local scripts/oidf_conformance/run_local_tls_stack.sh

# Aegaeon (server under test)
# Optional: use a pre-built image instead of a local `nix build .#docker-image`.
# AEGAEON_IMAGE=ghcr.io/<OWNER>/<REPO>/aegaeon-server:latest
AEGAEON_DOMAIN=aegaeon.localhost
AEGAEON_PUBLIC_BASE_URL=https://aegaeon.localhost:28443
AEGAEON_RUNTIME_ISSUER_HOST=aegaeon.localhost:28443

# Conformance suite (RP / test tool)
SUITE_DOMAIN=suite.localhost
SUITE_PUBLIC_BASE_URL=https://suite.localhost:28443
SUITE_REF=master

# Local SAN certificate basename under `scripts/oidf_conformance/certificates/`
CERT_PRIMARY_DOMAIN=oidf-localhost

# Local CA material generated by `prepare_local_tls.sh`
OIDF_LOCAL_CERTS=1
OIDF_LOCAL_CA_CERT_FILENAME=oidf-local-ca.crt
OIDF_LOCAL_CA_KEY_FILENAME=oidf-local-ca.key

# Published nginx ports (host)
NGINX_HTTP_PORT=28080
NGINX_HTTPS_PORT=28443

# Optional: override the OIDC signing kid used for ID Tokens / JWKS.
AEGAEON_OIDC_SIGNING_KID=oidc-signing-1
