+    else
+        export LD_LIBRARY_PATH="${_kani_ld_path}"
+    fi
+    export DYLD_LIBRARY_PATH="$LD_LIBRARY_PATH"
+    unset _kani_ld_path
+fi
+unset _kani_lib_paths
