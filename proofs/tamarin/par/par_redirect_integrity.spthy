theory PAR_Redirect_Integrity
begin

/*
 * RFC 9126 - Pushed Authorization Requests (PAR)
 * This proves redirect integrity and Mix-Up resistance with PAR
 */

builtins: signing, hashing

/* ==== Restrictions ==== */

restriction unique:
    "All x #i #j. Unique(x)@i & Unique(x)@j ==> #i = #j"

/* ==== Type Definitions ==== */

/* Register clients with authorization servers */
rule Register_Client:
    [ Fr(~client_secret) ]
    --[ ClientRegistered($Client, $AS, ~client_secret, $RedirectURI) ]->
    [ !Client($Client, $AS, ~client_secret, $RedirectURI)
    , Out($Client)
    , Out($RedirectURI)
    ]

/* Register authorization server */
rule Register_AS:
    [ Fr(~sk_as) ]
    --[ ASRegistered($AS, pk(~sk_as)) ]->
    [ !AS($AS, ~sk_as)
    , Out(pk(~sk_as))
    , Out($AS)
    ]

/* ==== PAR Request Flow ==== */

/* Step 1: Client pushes authorization request to PAR endpoint */
rule PAR_Request:
    [ !Client($Client, $AS, ~client_secret, $RedirectURI)
    , !AS($AS, ~sk_as)
    , Fr(~state)
    , Fr(~code_verifier)
    ]
    --[ PARRequest($Client, $AS, ~state, h(~code_verifier), $RedirectURI)
      , Unique(<'par_request', $Client, ~state>)
    ]->
    [ PARRequestSent($Client, $AS, ~state, h(~code_verifier), $RedirectURI)
    , Out(<$Client, ~client_secret, $RedirectURI, ~state, h(~code_verifier)>)
    ]

/* Step 2: AS processes PAR request and returns request_uri */
rule AS_Process_PAR:
    [ In(<$Client, client_secret, $RedirectURI, state, code_challenge>)
    , !Client($Client, $AS, client_secret, $RedirectURI)
    , !AS($AS, ~sk_as)
    , Fr(~request_uri)
    ]
    --[ PARStored($AS, $Client, ~request_uri, state, code_challenge, $RedirectURI)
      , RequestURIIssued($AS, $Client, ~request_uri)
      , Unique(<'request_uri', ~request_uri>)
    ]->
    [ !StoredPAR(~request_uri, $AS, $Client, state, code_challenge, $RedirectURI)
    , Out(~request_uri)
    , Out(sign(<'request_uri', ~request_uri, $AS>, ~sk_as))
    ]

/* Step 3: User authorization with request_uri */
rule User_Authorize_With_RequestURI:
    [ PARRequestSent($Client, $AS, state, code_challenge, $RedirectURI)
    , In(request_uri)
    , In(sign(<'request_uri', request_uri, $AS>, sk_as))
    , !AS($AS, sk_as)
    , !StoredPAR(request_uri, $AS, $Client, state, code_challenge, $RedirectURI)
    , Fr(~code)
    ]
    --[ UserAuthorized($AS, $Client, request_uri, ~code)
      , AuthorizationWithPAR($AS, $Client, state, ~code, $RedirectURI)
      , CodeIssued($AS, $Client, ~code)
      , Unique(<'auth_code', ~code>)
      , RequestURIConsumed($Client, request_uri)
    ]->
    [ !AuthCode(~code, $AS, $Client, state, code_challenge, $RedirectURI)
    , Out(<~code, state, $AS>)
    , !ConsumedRequestURI(request_uri)  /* request_uri can only be used once */
    ]

/* Step 4: Client exchanges code for token */
rule Token_Exchange:
    [ In(<code, state_recv, $AS_recv>)
    , !AuthCode(code, $AS, $Client, state, code_challenge, $RedirectURI)
    , !Client($Client, $AS, ~client_secret, $RedirectURI)
    , Fr(~token)
    ]
    --[ Eq(state_recv, state)
      , Eq($AS_recv, $AS)
      , TokenIssued($AS, $Client, ~token, code)
      , TokenExchanged($Client, ~token, $RedirectURI)
    ]->
    [ Out(~token) ]

/* ==== Attack Detection Rules ==== */

/* Detect request_uri reuse attempts */
rule Detect_RequestURI_Reuse:
    [ !ConsumedRequestURI(request_uri)
    , In(request_uri)
    ]
    --[ RequestURIReused(request_uri) ]->
    [ !ConsumedRequestURI(request_uri) ]

/* Detect Mix-Up attack attempts */
rule Detect_MixUp_Attack:
    [ !StoredPAR(request_uri, $AS1, $Client, state, code_challenge, $RedirectURI)
    , In(<$AS2, request_uri>)
    ]
    --[ MixUpAttempt($AS1, $AS2, request_uri) ]->
    [ ]

/* ==== Restrictions ==== */

restriction Equality:
    "All x y #i. Eq(x, y)@i ==> x = y"

restriction Uniqueness:
    "All x #i #j. Unique(x)@i & Unique(x)@j ==> #i = #j"

/* ==== Security Properties ==== */

/* Property 1: Redirect integrity - authorization codes are bound to registered redirect URIs */
lemma redirect_integrity:
    "All as client code #i.
        CodeIssued(as, client, code)@i
        ==> (Ex secret redirect_uri state #j.
                ClientRegistered(client, as, secret, redirect_uri)@j &
                AuthorizationWithPAR(as, client, state, code, redirect_uri)@i &
                #j < #i)"

/* Property 2: Request URI can only be used once */
lemma request_uri_single_use:
    "All as client uri code1 code2 #i #j.
        UserAuthorized(as, client, uri, code1)@i &
        UserAuthorized(as, client, uri, code2)@j
        ==> #i = #j"

/* Property 3: Mix-Up resistance - codes are bound to the correct AS */
lemma mixup_resistance:
    "All client token redirect_uri as1 as2 code #i #j #k.
        TokenExchanged(client, token, redirect_uri)@i &
        TokenIssued(as1, client, token, code)@j &
        CodeIssued(as2, client, code)@k &
        #k < #j & #j < #i
        ==> as1 = as2"

/* Property 4: PAR binding - authorization uses stored PAR parameters */
lemma par_binding:
    "All as client state code redirect_uri #i.
        AuthorizationWithPAR(as, client, state, code, redirect_uri)@i
        ==> (Ex uri cc #j.
                PARStored(as, client, uri, state, cc, redirect_uri)@j &
                #j < #i)"

/* Property 5: Client authentication in PAR */
lemma par_client_authentication:
    "All as client uri state cc redirect_uri #i.
        PARStored(as, client, uri, state, cc, redirect_uri)@i
        ==> (Ex secret #j.
                ClientRegistered(client, as, secret, redirect_uri)@j &
                #j < #i)"

/* Property 6: Request URI integrity */
lemma request_uri_integrity:
    "All as client uri #i.
        RequestURIIssued(as, client, uri)@i
        ==> (Ex state cc redirect_uri #j.
                PARRequest(client, as, state, cc, redirect_uri)@j &
                #j < #i)"

/* Property 7: No request_uri injection */
lemma no_request_uri_injection:
    "All as client uri code #i.
        UserAuthorized(as, client, uri, code)@i
        ==> (Ex #j. RequestURIIssued(as, client, uri)@j & #j < #i)"

/* Property 8: Authorization follows PAR request */
lemma authorization_requires_par:
  "All as client state code redirect_uri #i.
      AuthorizationWithPAR(as, client, state, code, redirect_uri)@i
      ==> (Ex cc #j.
              PARRequest(client, as, state, cc, redirect_uri)@j &
              #j < #i)"

/* Property 9: The request_uri is consumed (single-use) at authorization */
lemma request_uri_consumed_on_use:
  "All as client uri code #i.
     UserAuthorized(as, client, uri, code)@i ==>
     (Ex #j. RequestURIConsumed(client, uri)@j & ((#j < #i) | (#j = #i)))"

/* Property 10: Issued request_uri values are unique */
lemma request_uri_issued_unique:
  "All as1 as2 c1 c2 uri #i #j.
     RequestURIIssued(as1, c1, uri)@i & RequestURIIssued(as2, c2, uri)@j ==> #i = #j"

end
