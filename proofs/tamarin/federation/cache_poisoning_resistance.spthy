theory Federation_Cache_Poisoning_Resistance
begin

/*
 * Federation Cache Poisoning Resistance
 *
 * The federation trust chain resolver caches entity configurations and
 * resolved trust chains. An attacker who can inject entries into the
 * cache could redirect authentication flows to malicious IdPs.
 *
 * This model proves that:
 * 1. Cache entries are only written after JWS signature verification
 *    against a registered trust anchor's public key.
 * 2. An attacker cannot inject a cache entry for an entity they do
 *    not control the signing key for (without compromising the TA).
 * 3. Entity cache is isolated per environment (no cross-environment
 *    cache pollution).
 *
 * Security properties:
 * - no_unverified_cache: every cache entry traces to JWS verification
 * - attacker_cannot_poison: no forged entity in cache without entity/TA compromise
 * - environment_isolation: cache entries are bound to their environment
 * - cache_entry_authenticity: cached JWKS matches verified entity key
 * - no_stale_key_cache: cache entries reference keys from a valid chain
 *
 * F-3 fix (security review): attacker_cannot_poison now scopes the
 * compromise disjunct to the entity itself or the vouching trust anchor,
 * preventing trivial satisfaction via unrelated key compromise.
 *
 * F-4 note (accepted): Fetch_And_Verify_Entity_Config assumes
 * pre-knowledge of the entity's PK via !Entity_PK. In reality the PK
 * is extracted from the self-signed config. This is an acceptable
 * simplification; key misbinding is outside this model's scope.
 *
 * Known limitations:
 * - No temporal cache expiry (Tamarin lacks monotonic clock)
 * - Single cache per environment (no sharding)
 */

builtins: signing, hashing

/* ============ Restrictions ============ */

restriction Equality:
  "All x y #i. Eq(x, y)@i ==> x = y"

restriction Inequality:
  "All x y #i. Neq(x, y)@i ==> not(x = y)"

restriction Unique:
  "All x #i #j. Unique(x)@i & Unique(x)@j ==> #i = #j"

/* ============ Key Management ============ */

rule Entity_Keygen:
  [ Fr(~sk) ]
  --[ Entity_Key($Entity, pk(~sk)),
      Honest_Key($Entity, pk(~sk)) ]->
  [ !Entity_SK($Entity, ~sk),
    !Entity_PK($Entity, pk(~sk)),
    Out(pk(~sk)) ]

rule Entity_Compromise:
  [ !Entity_SK(A, sk) ]
  --[ Compromised(A) ]->
  [ Out(sk) ]

/* ============ Trust Anchor ============ */

rule Trust_Anchor_Init:
  let config = sign(<'entity_config', $TA, pk(ta_sk), 'trust_anchor'>, ta_sk)
  in
  [ !Entity_SK($TA, ta_sk) ]
  --[ TA_Established($TA, pk(ta_sk)),
      Unique(<'ta', $TA>) ]->
  [ !TrustAnchor($TA, pk(ta_sk)),
    Out(config) ]

// TA issues subordinate statement for entity (with entity's public key)
rule TA_Issue_Subordinate:
  let stmt_claims = <'subordinate_statement', $TA, $Entity, entity_pk>
      stmt = sign(stmt_claims, ta_sk)
  in
  [ !Entity_SK($TA, ta_sk),
    !Entity_PK($Entity, entity_pk) ]
  --[ Subordinate_Issued($TA, $Entity, entity_pk) ]->
  [ !SubStmt($TA, $Entity, stmt, entity_pk),
    Out(stmt) ]

/* ============ Entity Configuration ============ */

// Entity publishes self-signed configuration
rule Entity_Publish_Config:
  let config_claims = <'entity_config', $Entity, pk(entity_sk), $entity_type,
                        $issuer>
      config = sign(config_claims, entity_sk)
  in
  [ !Entity_SK($Entity, entity_sk) ]
  --[ Config_Published($Entity, pk(entity_sk), $issuer),
      Unique(<'config', $Entity>) ]->
  [ !EntityConfig($Entity, pk(entity_sk), $issuer, config),
    Out(config) ]

/* ============ Environment Setup ============ */

// Environment registers a trust anchor for chain resolution
rule Environment_Register_TA:
  [ !TrustAnchor($TA, ta_pk) ]
  --[ Env_TA_Registered($Env, $TA, ta_pk) ]->
  [ !EnvTrustAnchor($Env, $TA, ta_pk) ]

/* ============ Federation Fetcher (with verification) ============ */

// Fetch entity configuration from network and verify JWS self-signature
rule Fetch_And_Verify_Entity_Config:
  let config_claims = <'entity_config', entity_id, entity_pk, entity_type,
                        issuer>
  in
  [ In(config),
    !Entity_PK(entity_id, entity_pk) ]
  --[ Eq(verify(config, config_claims, entity_pk), true),
      Config_JWS_Verified($Env, entity_id, config, entity_pk) ]->
  [ Verified_Config($Env, entity_id, entity_pk, issuer, config) ]

// Resolve trust chain: verify subordinate statement from TA, then
// verify entity config self-signature. Both must pass before caching.
rule Resolve_And_Verify_Chain:
  let stmt_claims = <'subordinate_statement', $TA, entity_id, entity_pk>
  in
  [ Verified_Config($Env, entity_id, entity_pk, issuer, config),
    !EnvTrustAnchor($Env, $TA, ta_pk),
    !Entity_PK($TA, ta_pk),
    !SubStmt($TA, entity_id, sub_stmt, entity_pk) ]
  --[ Eq(verify(sub_stmt, stmt_claims, ta_pk), true),
      Chain_Verified($Env, entity_id, $TA, entity_pk, issuer),
      Both_JWS_Verified($Env, entity_id, config, sub_stmt) ]->
  [ Chain_Ready_To_Cache($Env, entity_id, $TA, entity_pk, issuer) ]

/* ============ Cache Write (only after verification) ============ */

// Cache write is gated on Chain_Ready_To_Cache, which is only produced
// after BOTH the entity configuration JWS and the subordinate statement
// JWS have been cryptographically verified.
rule Cache_Write:
  [ Chain_Ready_To_Cache($Env, entity_id, $TA, entity_pk, issuer) ]
  --[ Cache_Entry_Written($Env, entity_id, $TA, entity_pk, issuer),
      Unique(<'cache', $Env, entity_id, $TA>) ]->
  [ !CachedEntity($Env, entity_id, $TA, entity_pk, issuer) ]

/* ============ Cache Read ============ */

// Cache read: only returns entries for the requesting environment
rule Cache_Read:
  [ !CachedEntity($Env, entity_id, $TA, entity_pk, issuer) ]
  --[ Cache_Hit($Env, entity_id, entity_pk, issuer) ]->
  [ Cache_Result($Env, entity_id, entity_pk, issuer) ]

/* ============ Attacker Actions ============ */

// Attacker publishes a malicious entity configuration with a key they control.
// This is always possible in the Dolev-Yao model.
rule Attacker_Publish_Fake_Config:
  [ Fr(~atk_sk) ]
  --[ Attacker_Config($Attacker, pk(~atk_sk), $fake_issuer) ]->
  [ Out(sign(<'entity_config', $Attacker, pk(~atk_sk), 'openid_provider',
              $fake_issuer>, ~atk_sk)) ]

// Attacker tries to get a subordinate statement from TA for their entity.
// This is only possible if the TA is compromised (modeled by Entity_Compromise).

/* ============ Security Properties ============ */

// No unverified cache entry: every cached entity had its JWS signatures
// verified (both entity config self-signature and TA subordinate statement).
lemma no_unverified_cache:
  "All env entity ta pk issuer #i.
     Cache_Entry_Written(env, entity, ta, pk, issuer)@i
     ==> Ex config sub_stmt #j.
           Both_JWS_Verified(env, entity, config, sub_stmt)@j & #j < #i"

// Attacker cannot poison cache without RELEVANT key compromise:
// If a cache entry exists for an entity, then either the entity's key
// was honestly generated, or the entity itself was compromised, or the
// trust anchor that vouched for it was compromised.
// F-3 fix: scoped to entity/TA — compromise of an unrelated entity
// does NOT satisfy this lemma.
lemma attacker_cannot_poison:
  "All env entity ta pk issuer #i.
     Cache_Entry_Written(env, entity, ta, pk, issuer)@i
     ==> (Ex #j. Honest_Key(entity, pk)@j)
         | (Ex #c. Compromised(entity)@c)
         | (Ex #c. Compromised(ta)@c)"

// Environment isolation: a cache hit for environment E1 requires
// a cache write for that same environment E1.
lemma environment_isolation:
  "All env entity pk issuer #i.
     Cache_Hit(env, entity, pk, issuer)@i
     ==> Ex ta #j.
           Cache_Entry_Written(env, entity, ta, pk, issuer)@j & #j < #i"

// Cache entry authenticity: cached entity key matches a key that was
// verified through the trust chain (TA vouches for it).
lemma cache_entry_authenticity:
  "All env entity ta pk issuer #i.
     Cache_Entry_Written(env, entity, ta, pk, issuer)@i
     ==> Ex #j. Chain_Verified(env, entity, ta, pk, issuer)@j & #j < #i"

// No stale key in cache: cached key traces to a subordinate statement
// issued by the trust anchor for that entity.
lemma no_stale_key_cache:
  "All env entity ta pk issuer #i.
     Cache_Entry_Written(env, entity, ta, pk, issuer)@i
     ==> Ex #j. Subordinate_Issued(ta, entity, pk)@j & #j < #i"

end
