theory CSRFProtection
begin

builtins: hashing

/* CSRF protection using state parameter */

// Client initiates authorization with state
rule Client_Init:
  [ Fr(~state) ]
  --[ StateGenerated($Client, ~state) ]->
  [ ClientState($Client, ~state), !StateStore($Client, ~state) ]

// Authorization server receives request
rule AS_Authorize:
  [ Fr(~code), !StateStore($Client, state) ]
  --[ AuthRequest($AS, $Client, state) ]->
  [ Out(<~code, h(state)>), !AuthorizedCode(~code, state) ]

// Client validates response
rule Client_Validate:
  [ ClientState($Client, state), In(<code, h_state>), !AuthorizedCode(code, state) ]
  --[ Eq(h_state, h(state)),
      StateValidated($Client, state),
      ResponseAccepted($Client, code) ]->
  [ ]

restriction Equality:
  "All x y #i. Eq(x,y)@i ==> x = y"

// Attacker tries CSRF
rule CSRF_Attack:
  [ In(state) ]
  --[ CSRFAttempt($Attacker, state) ]->
  [ Out(<$Attacker, state>) ]

// Security properties
lemma csrf_protection:
  "All C code state #i. ResponseAccepted(C, code) @ i &
    StateValidated(C, state) @ i ==>
    Ex #j. StateGenerated(C, state) @ j & j < i"

// State unpredictability: distinct state-generation events never collide
// (guaranteed by Fr(~state)). Front-channel `state` is not secret in OAuth;
// the security-relevant property is unpredictability, not secrecy. This
// replaces the prior K(state)-based formulation, which was vacuous (raw
// `state` is never released, so K(state) is unreachable) and would be FALSE
// if it were reachable. Parallels the removal of `token_secrecy` and mirrors
// state_echo_integrity.spthy's StateUnpredictability.
lemma state_unpredictability:
  "All C1 C2 state #i #j.
     StateGenerated(C1, state) @ i & StateGenerated(C2, state) @ j
     ==> #i = #j"

lemma response_accepted_reachable:
  exists-trace
  "Ex C code #i. ResponseAccepted(C, code) @ i"

end
