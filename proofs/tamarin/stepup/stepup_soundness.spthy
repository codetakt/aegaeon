theory StepUpSoundness
begin

// Step-up authentication model: when step-up is required for a request,
// a token for that request can only be issued after a challenge bound to
// that request has been completed.
//
// 2026-08-05 rework: the previous model consumed the only StepUpReq fact
// in IssueChallenge, making TokenIssuedAfterStepUp unreachable and the
// soundness lemma vacuously true, and contained an unconstrained
// TokenIssuedWithoutStepUp bypass rule outside the lemma's action facts.
// IssueChallenge now restores StepUpReq, the bypass rule is removed, and
// reachability is witnessed by an exists-trace lemma.

rule StepUpRequired:
  [ Fr(~req) ]
  --[ StepUpRequired($Client, ~req) ]->
  [ StepUpReq($Client, ~req) ]

rule IssueChallenge:
  [ StepUpReq(C, req), Fr(~challenge) ]
  --[ ChallengeIssued(C, req, ~challenge) ]->
  [ StepUpReq(C, req), Challenge(C, req, ~challenge) ]

rule CompleteChallenge:
  [ Challenge(C, req, challenge) ]
  --[ ChallengeCompleted(C, req, challenge) ]->
  [ StepUpCompleted(C, req) ]

rule TokenIssuedAfterStepUp:
  [ StepUpReq(C, req), StepUpCompleted(C, req), Fr(~token) ]
  --[ TokenIssued(C, req, ~token) ]->
  [ ]

// Reachability witness: the soundness lemma below is meaningless if
// TokenIssued is unreachable.
lemma token_issuance_reachable:
  exists-trace
  "Ex C req tok #i. TokenIssued(C, req, tok) @ i"

lemma stepup_soundness:
  "All C req tok #i #j.
    StepUpRequired(C, req) @ j &
    TokenIssued(C, req, tok) @ i ==>
    Ex ch #k. ChallengeCompleted(C, req, ch) @ k & j < k & k < i"

end
