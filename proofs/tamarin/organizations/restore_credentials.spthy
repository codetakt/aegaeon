theory RestoreCredentials
begin

/* Finite diagnostic lifecycle. AuthorizedRestore is a trusted operator action,
   not a protocol authenticating that operator or an implementation proof.
   Audit facts are retained observations, never commands to replay into the DB.
   Password hashing, SQL, clocks, external proofs and worker fencing are outside
   this model. No restriction assumes the result. */

rule Provision:
  [ Fr(~user), Fr(~password), Fr(~generation), Fr(~session) ]
  --[ Provisioned(~user, ~password, ~generation, ~session) ]->
  [ BeforeChange(~user, ~password, ~generation),
    !Backup(~user, ~password), !Session(~user, ~generation, ~session),
    Out(~password), Out(~session) ]

rule ChangePassword:
  [ BeforeChange(user, password, generation), Fr(~new_password) ]
  --[ PasswordChanged(user, password, ~new_password) ]->
  [ Changed(user, ~new_password, generation),
    !AuditPasswordChange(user, password, ~new_password) ]

rule AuthorizedRestore:
  [ Changed(user, current_password, old_generation), !Backup(user, password),
    Fr(~generation) ]
  --[ Restored(user, password, old_generation, ~generation) ]->
  [ !Selected(user, password, ~generation), LoginAttempt(user),
    SessionAttempt(user), InsecureAttempt(user) ]

rule FreshLogin:
  [ !Selected(user, password, generation), LoginAttempt(user), In(password),
    Fr(~session) ]
  --[ Authenticated(user, password, generation) ]->
  [ !Session(user, generation, ~session), Out(~session) ]

rule UseSession:
  [ !Selected(user, password, generation), SessionAttempt(user),
    !Session(user, generation, session), In(session) ]
  --[ SessionAccepted(user, generation, session) ]->
  [ ]

/* Deliberately separate negative control: omitted generation comparison.
   Its event is not counted as acceptance by the intended model. */
rule InsecureUseSession:
  [ !Selected(user, password, generation), InsecureAttempt(user),
    !Session(user, any_generation, session), In(session) ]
  --[ InsecureSessionAccepted(user, generation, session) ]->
  [ ]

lemma selected_password_can_authenticate:
  exists-trace
  "Ex user password new_password old_generation generation #c #r #a.
    PasswordChanged(user, password, new_password) @ c &
    Restored(user, password, old_generation, generation) @ r &
    Authenticated(user, password, generation) @ a & c < r & r < a"

lemma authentication_uses_selected_state:
  "All user password generation #a.
    Authenticated(user, password, generation) @ a
    ==> Ex old_generation #r.
      Restored(user, password, old_generation, generation) @ r & r < a"

lemma old_session_rejected:
  "All user password old_generation generation session #p #r #a.
    Provisioned(user, password, old_generation, session) @ p &
    Restored(user, password, old_generation, generation) @ r &
    SessionAccepted(user, generation, session) @ a
    ==> F"

lemma fresh_session_can_resume:
  exists-trace
  "Ex user password generation session #a #s.
    Authenticated(user, password, generation) @ a &
    SessionAccepted(user, generation, session) @ s & a < s"

lemma omitted_generation_accepts_old_session:
  exists-trace
  "Ex user password old_generation generation session #p #r #s.
    Provisioned(user, password, old_generation, session) @ p &
    Restored(user, password, old_generation, generation) @ r &
    InsecureSessionAccepted(user, generation, session) @ s & p < r & r < s"

end
