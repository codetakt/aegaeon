{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/released-client-claim-report.schema.json",
  "title": "Aegaeon SDK Released Client Claim Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "claim_target",
    "current_state",
    "target_state",
    "evidence",
    "publication_org_tasks",
    "ready",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_target": {
      "type": "string",
      "enum": [
        "released-client-claim"
      ]
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_phase",
        "released_client_claim_active",
        "canonical_statement"
      ],
      "properties": {
        "claim_phase": {
          "type": "string",
          "enum": [
            "pre-release-client-baseline",
            "released-client-claim"
          ]
        },
        "released_client_claim_active": {
          "type": "boolean"
        },
        "canonical_statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_phase",
        "canonical_statement",
        "default_profile",
        "promoted_client_slices",
        "compat_only_surfaces"
      ],
      "properties": {
        "claim_phase": {
          "type": "string",
          "enum": [
            "released-client-claim"
          ]
        },
        "canonical_statement": {
          "type": "string",
          "minLength": 1
        },
        "default_profile": {
          "type": "string",
          "enum": [
            "verified-core",
            "aegaeon-rs256",
            "compat-interop"
          ]
        },
        "promoted_client_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compat_only_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_boundary_path",
        "release_attestation_path",
        "promotion_report_path",
        "managed_provider_evidence_path",
        "managed_provider_evidence_age_hours",
        "managed_provider_lane_name",
        "managed_provider_source_repository",
        "managed_provider_source_ref",
        "managed_provider_source_workflow",
        "managed_provider_source_job",
        "managed_provider_github_run_id_present",
        "managed_provider_github_sha_present",
        "admin_sdk_evidence_path",
        "admin_sdk_evidence_age_hours",
        "admin_sdk_lane_name",
        "admin_sdk_source_repository",
        "admin_sdk_source_ref",
        "admin_sdk_source_workflow",
        "admin_sdk_source_job",
        "admin_sdk_github_run_id_present",
        "admin_sdk_github_sha_present",
        "promotion_report_ready",
        "managed_provider_evidence_present",
        "admin_sdk_evidence_present",
        "signed_release_attestation_present",
        "sbom_publication_present"
      ],
      "properties": {
        "claim_boundary_path": {
          "type": "string",
          "minLength": 1
        },
        "release_attestation_path": {
          "type": "string",
          "minLength": 1
        },
        "promotion_report_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_evidence_age_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "managed_provider_lane_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_source_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_source_workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_source_job": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_provider_github_run_id_present": {
          "type": "boolean"
        },
        "managed_provider_github_sha_present": {
          "type": "boolean"
        },
        "admin_sdk_evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_evidence_age_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "admin_sdk_lane_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_source_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_source_workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_source_job": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_sdk_github_run_id_present": {
          "type": "boolean"
        },
        "admin_sdk_github_sha_present": {
          "type": "boolean"
        },
        "promotion_report_ready": {
          "type": "boolean"
        },
        "managed_provider_evidence_present": {
          "type": "boolean"
        },
        "admin_sdk_evidence_present": {
          "type": "boolean"
        },
        "signed_release_attestation_present": {
          "type": "boolean"
        },
        "sbom_publication_present": {
          "type": "boolean"
        }
      }
    },
    "publication_org_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done"
            ]
          }
        }
      }
    },
    "ready": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
