{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/admin-ui-security-state-machine.schema.json",
  "title": "Aegaeon Admin UI Security State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "model_id",
    "claim_boundary",
    "initial_state",
    "states",
    "transitions",
    "operation_classes",
    "route_groups",
    "forbidden_client_surfaces",
    "drift_policy",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_type",
        "included_surfaces",
        "excluded_surfaces",
        "trusted_boundaries"
      ],
      "properties": {
        "boundary_type": {
          "const": "admin-control-plane-security-boundary"
        },
        "included_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trusted_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "initial_state": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "operation_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation_class"
      }
    },
    "route_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route_group"
      }
    },
    "forbidden_client_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "drift_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_openapi_path",
        "management_client_reference_path",
        "require_all_openapi_operations_in_management_client",
        "require_write_csrf_origin_implementation",
        "dangerous_write_fragments"
      ],
      "properties": {
        "management_openapi_path": {
          "type": "string",
          "minLength": 1
        },
        "management_client_reference_path": {
          "type": "string",
          "minLength": 1
        },
        "require_all_openapi_operations_in_management_client": {
          "type": "boolean"
        },
        "require_write_csrf_origin_implementation": {
          "type": "boolean"
        },
        "dangerous_write_fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "management_session",
        "csrf_state",
        "privileged"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "management_session": {
          "type": "string",
          "enum": [
            "absent",
            "present"
          ]
        },
        "csrf_state": {
          "type": "string",
          "enum": [
            "absent",
            "primed",
            "server-owned"
          ]
        },
        "privileged": {
          "type": "boolean"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "event",
        "operation_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "operation_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "writes_management_api",
        "requires_management_session",
        "transport_boundary",
        "csrf_origin_guard",
        "admin_confirmation_required",
        "audit_event_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "writes_management_api": {
          "type": "boolean"
        },
        "requires_management_session": {
          "type": "boolean"
        },
        "transport_boundary": {
          "type": "string",
          "enum": [
            "management-client",
            "server-owned"
          ]
        },
        "csrf_origin_guard": {
          "type": "string",
          "enum": [
            "not-required",
            "server-enforced"
          ]
        },
        "admin_confirmation_required": {
          "type": "boolean"
        },
        "audit_event_required": {
          "type": "boolean"
        }
      }
    },
    "route_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "requires_management_session",
        "allowed_operation_classes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_management_session": {
          "type": "boolean"
        },
        "allowed_operation_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
