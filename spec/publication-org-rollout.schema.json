{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/publication-org-rollout.schema.json",
  "title": "Aegaeon Publication Organization Rollout Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "rollout_target",
    "target_repository",
    "tasks",
    "ready",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollout_target": {
      "type": "string",
      "enum": [
        "released-client-claim"
      ]
    },
    "target_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo",
        "branch"
      ],
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "ready": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "detail"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "publication_org_branch_protection",
            "publication_org_secret_rollout"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "done"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
