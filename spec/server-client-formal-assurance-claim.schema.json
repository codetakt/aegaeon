{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/server-client-formal-assurance-claim.schema.json",
  "title": "Aegaeon Server / Client Formal Assurance Claim Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_target",
    "claim_active",
    "claim_stage",
    "current_public_wording",
    "future_allowed_wording",
    "minimum_qualified_wording",
    "prohibited_wording",
    "included_claim_boundaries",
    "excluded_tcb_boundaries",
    "dependent_gates",
    "required_evidence"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "claim_target": {
      "const": "server-client-formal-assurance"
    },
    "claim_active": {
      "type": "boolean"
    },
    "claim_stage": {
      "type": "string",
      "enum": [
        "phase5-planned",
        "phase5-internal-complete",
        "release-candidate",
        "public-claim-active"
      ]
    },
    "current_public_wording": {
      "type": "string",
      "minLength": 1
    },
    "future_allowed_wording": {
      "type": "string",
      "minLength": 1
    },
    "minimum_qualified_wording": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_wording": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "included_claim_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim_boundary"
      }
    },
    "excluded_tcb_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tcb_boundary"
      }
    },
    "dependent_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependent_gate"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "assurance_level",
        "evidence_uri"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "assurance_level": {
          "type": "string",
          "enum": [
            "assumption-qualified-formal",
            "verified-core",
            "security-tested",
            "runtime-supported",
            "release-gated"
          ]
        },
        "evidence_uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tcb_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required_disclosure"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_disclosure": {
          "const": true
        }
      }
    },
    "dependent_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "path",
        "kind",
        "must_be_ready_for_activation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "claim-gate",
            "client-boundary",
            "client-promotion",
            "released-client-claim",
            "evidence-preflight"
          ]
        },
        "must_be_ready_for_activation": {
          "type": "boolean"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "required_for_activation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "planned",
            "in_progress",
            "complete",
            "not_applicable"
          ]
        },
        "required_for_activation": {
          "type": "boolean"
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
