{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/enterprise-slo-baseline.schema.json",
  "title": "Aegaeon Enterprise SLO Baseline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "baseline_id",
    "source_revision",
    "generated_at",
    "deployment",
    "scenarios",
    "observability",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "target_url",
        "database_backend",
        "signer_backend",
        "feature_flags"
      ],
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "target_url": {
          "type": "string",
          "minLength": 1
        },
        "database_backend": {
          "type": "string",
          "minLength": 1
        },
        "signer_backend": {
          "type": "string",
          "minLength": 1
        },
        "feature_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics_uri",
        "dashboard_uri",
        "alerts_uri"
      ],
      "properties": {
        "metrics_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "dashboard_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "alerts_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "decision"
      ],
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "required",
        "report_uri"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "report_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "target_rps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "error_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p99_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
