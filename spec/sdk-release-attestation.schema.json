{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/sdk-release-attestation.schema.json",
  "title": "Aegaeon SDK Release Attestation Scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "release_phase",
    "source",
    "publication",
    "publish_manifest",
    "client_claim_boundary",
    "verified_core",
    "deferred_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_phase": {
      "type": "string",
      "enum": [
        "pre-release-client-baseline",
        "released-client-claim"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_ref",
        "github_sha",
        "github_run_id",
        "github_workflow",
        "npm_dist_tag"
      ],
      "properties": {
        "github_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "npm_dist_tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npm_provenance_enabled",
        "signed_release_attestation_present",
        "sbom_publication_present"
      ],
      "properties": {
        "npm_provenance_enabled": {
          "type": "boolean"
        },
        "signed_release_attestation_present": {
          "type": "boolean"
        },
        "sbom_publication_present": {
          "type": "boolean"
        }
      }
    },
    "publish_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "tarball_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tarball_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "client_claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "claim_phase",
        "released_client_claim_active",
        "default_profile",
        "promoted_client_slices",
        "compat_only_surfaces"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_phase": {
          "type": "string",
          "enum": [
            "pre-release-client-baseline",
            "released-client-claim"
          ]
        },
        "released_client_claim_active": {
          "type": "boolean"
        },
        "default_profile": {
          "type": "string",
          "enum": [
            "verified-core",
            "aegaeon-rs256",
            "compat-interop"
          ]
        },
        "promoted_client_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compat_only_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verified_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "handoff_manifest_path",
        "handoff_manifest_sha256"
      ],
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "handoff_manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "handoff_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deferred_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
