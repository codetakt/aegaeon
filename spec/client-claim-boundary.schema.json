{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/client-claim-boundary.schema.json",
  "title": "Aegaeon SDK Client Claim Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_phase",
    "released_client_claim_active",
    "default_profile",
    "profiles",
    "promoted_client_slices",
    "compat_only_surfaces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_phase": {
      "type": "string",
      "enum": [
        "pre-release-client-baseline",
        "released-client-claim"
      ]
    },
    "released_client_claim_active": {
      "type": "boolean"
    },
    "default_profile": {
      "type": "string",
      "enum": [
        "verified-core",
        "aegaeon-rs256",
        "compat-interop"
      ]
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified-core",
        "aegaeon-rs256",
        "compat-interop"
      ],
      "properties": {
        "verified-core": {
          "$ref": "#/$defs/profile"
        },
        "aegaeon-rs256": {
          "$ref": "#/$defs/profile"
        },
        "compat-interop": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "promoted_client_slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/promotedSlice"
      }
    },
    "compat_only_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compatSurface"
      }
    }
  },
  "$defs": {
    "algorithm": {
      "type": "string",
      "enum": [
        "EdDSA",
        "RS256",
        "ES256"
      ]
    },
    "signatureModel": {
      "type": "string",
      "enum": [
        "verified-core",
        "adapter-preverified",
        "compat",
        "unsupported"
      ]
    },
    "algorithmList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/algorithm"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jwt_algorithms",
        "dpop_algorithms",
        "signature_models",
        "released_claim_target"
      ],
      "properties": {
        "jwt_algorithms": {
          "$ref": "#/$defs/algorithmList"
        },
        "dpop_algorithms": {
          "$ref": "#/$defs/algorithmList"
        },
        "signature_models": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/$defs/algorithm"
          },
          "minProperties": 1,
          "patternProperties": {
            "^(EdDSA|RS256|ES256)$": {
              "$ref": "#/$defs/signatureModel"
            }
          }
        },
        "released_claim_target": {
          "type": "boolean"
        }
      }
    },
    "surfaceType": {
      "type": "string",
      "enum": [
        "oidc-id-token",
        "jwt-claims",
        "dpop"
      ]
    },
    "promotedSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "algorithms",
        "applies_to",
        "signature_model",
        "released_claim_target",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "algorithms": {
          "$ref": "#/$defs/algorithmList"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceType"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "signature_model": {
          "$ref": "#/$defs/signatureModel"
        },
        "released_claim_target": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "algorithms",
        "applies_to",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "algorithms": {
          "$ref": "#/$defs/algorithmList"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceType"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
