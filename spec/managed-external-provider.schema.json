{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/managed-external-provider.schema.json",
  "title": "Managed External Provider Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerName",
    "issuer",
    "clientId",
    "loginScript"
  ],
  "properties": {
    "providerName": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "discoveryUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "authMethod": {
      "type": "string",
      "enum": [
        "none",
        "client_secret_basic",
        "client_secret_post"
      ]
    },
    "usernameEnv": {
      "type": "string",
      "const": "AEGAEON_MANAGED_EXTERNAL_PROVIDER_USERNAME"
    },
    "passwordEnv": {
      "type": "string",
      "const": "AEGAEON_MANAGED_EXTERNAL_PROVIDER_PASSWORD"
    },
    "clientSecretEnv": {
      "type": "string",
      "const": "AEGAEON_MANAGED_EXTERNAL_PROVIDER_CLIENT_SECRET"
    },
    "loginScript": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "pattern"
            ],
            "properties": {
              "action": {
                "const": "waitForURL"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "waitForSelector"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "fill"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "valueFrom": {
                "type": "string",
                "enum": [
                  "username",
                  "password"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "valueFrom"
                  ]
                }
              },
              {
                "required": [
                  "valueFrom"
                ],
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "click"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "clickIfVisible"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "key"
            ],
            "properties": {
              "action": {
                "const": "press"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "const": "waitForTimeout"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 0
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "anyOf": [
              {
                "required": [
                  "timeoutMs"
                ]
              },
              {
                "required": [
                  "ms"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
