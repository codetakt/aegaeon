{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/certification-claim.schema.json",
  "title": "Aegaeon Certification Claim Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_target",
    "claim_active",
    "current_public_wording",
    "future_allowed_wording",
    "certification_scope",
    "required_evidence"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "claim_target": {
      "const": "certification"
    },
    "claim_active": {
      "type": "boolean"
    },
    "current_public_wording": {
      "type": "string",
      "minLength": 1
    },
    "future_allowed_wording": {
      "type": "string",
      "minLength": 1
    },
    "certification_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "target"
      ],
      "properties": {
        "selected": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "required_for_activation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "planned",
            "in_progress",
            "complete",
            "not_applicable"
          ]
        },
        "required_for_activation": {
          "type": "boolean"
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
