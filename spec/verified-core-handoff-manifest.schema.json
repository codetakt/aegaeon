{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Core Handoff Manifest",
  "description": "Canonical metadata for the release bundle consumed by the separate SDK repository.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_format",
    "handoff_manifest_file",
    "core_repo",
    "core_release_tag",
    "source_commit",
    "source_workflow",
    "generated_at",
    "release_artifact_name",
    "dispatch_artifact_name",
    "required_files",
    "optional_files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_format": {
      "type": "string",
      "enum": ["github-release", "direct-artifact"]
    },
    "handoff_manifest_file": {
      "type": "string",
      "minLength": 1
    },
    "core_repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "core_release_tag": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "source_workflow": {
      "type": "string",
      "minLength": 1
    },
    "source_run_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_url": {
      "type": "string",
      "format": "uri"
    },
    "release_artifact_name": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_artifact_name": {
      "type": "string",
      "minLength": 1
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optional_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
