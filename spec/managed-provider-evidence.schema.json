{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/managed-provider-evidence.schema.json",
  "title": "Aegaeon SDK Managed Provider Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "provider",
    "lane",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_path",
        "config_sha256",
        "claim_boundary_path",
        "claim_boundary_sha256",
        "github_run_id",
        "github_workflow",
        "github_repository",
        "github_ref",
        "github_sha",
        "github_job"
      ],
      "properties": {
        "config_path": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_boundary_path": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "github_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_job": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$"
        },
        "imported_github_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_github_workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_github_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_github_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_github_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_github_job": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class",
        "issuer",
        "client_id",
        "auth_method"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "commercial",
            "enterprise",
            "sandbox",
            "self-hosted"
          ]
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "auth_method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hosted",
        "status",
        "browser"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hosted": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "browser": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_profile",
        "claim_phase",
        "promoted_client_slices",
        "compat_only_surfaces"
      ],
      "properties": {
        "default_profile": {
          "type": "string",
          "enum": [
            "verified-core",
            "aegaeon-rs256",
            "compat-interop"
          ]
        },
        "claim_phase": {
          "type": "string",
          "enum": [
            "pre-release-client-baseline",
            "released-client-claim"
          ]
        },
        "promoted_client_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compat_only_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
