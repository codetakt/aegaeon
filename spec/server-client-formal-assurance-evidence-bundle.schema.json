{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegaeon.dev/spec/server-client-formal-assurance-evidence-bundle.schema.json",
  "title": "Aegaeon Server / Client Formal Assurance Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "generated_at",
    "claim_target",
    "claim_gate_path",
    "claim_gate_sha256",
    "release_stage",
    "public_claim_ready",
    "dependent_gate_snapshots",
    "evidence_items",
    "review_passes",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_target": {
      "const": "server-client-formal-assurance"
    },
    "claim_gate_path": {
      "type": "string",
      "minLength": 1
    },
    "claim_gate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_stage": {
      "type": "string",
      "enum": [
        "internal-preflight",
        "internal-complete",
        "release-candidate",
        "external-complete"
      ]
    },
    "public_claim_ready": {
      "type": "boolean"
    },
    "dependent_gate_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependent_gate_snapshot"
      }
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "review_passes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/review_pass"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "dependent_gate_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "status",
        "ready_for_activation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "blocked",
            "in_progress",
            "ready"
          ]
        },
        "ready_for_activation": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "path",
        "fresh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "blocked",
            "in_progress",
            "complete"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "fresh": {
          "type": "boolean"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "reviewer",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "type": "string",
          "enum": [
            "claim-wording",
            "formal-boundary",
            "server-implementation",
            "sdk-adapter",
            "release-custody",
            "external-security"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "blocked"
          ]
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
