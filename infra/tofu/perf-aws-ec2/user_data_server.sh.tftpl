#!/usr/bin/env bash

set -euo pipefail

exec > >(tee /var/log/aegaeon-user-data.log | logger -t aegaeon-user-data -s 2>/dev/console) 2>&1

echo "[aegaeon-user-data] starting server bootstrap at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

install -d -m 0700 /etc/aegaeon

dnf_install() {
  local -a packages=("$@")
  local attempts=5
  local delay_secs=5

  for attempt in $(seq 1 "$attempts"); do
    if dnf install -y "$${packages[@]}"; then
      return 0
    fi
    echo "[aegaeon-user-data] dnf install failed (attempt $${attempt}/$${attempts}); retrying in $${delay_secs}s..." >&2
    sleep "$delay_secs"
  done

  return 1
}

if ! command -v curl >/dev/null 2>&1; then
  dnf_install curl || dnf_install curl-minimal
fi

if [[ ! -x /usr/bin/python3 ]]; then
  dnf_install python3
fi

if [[ ! -x /usr/bin/aws ]]; then
  dnf_install awscli
fi

if ! command -v docker >/dev/null 2>&1; then
  if ! dnf_install docker; then
    dnf_install podman podman-docker
  fi
fi

systemctl enable --now amazon-ssm-agent || true
if systemctl cat docker.service >/dev/null 2>&1; then
  systemctl enable --now docker.service
fi

cat >/etc/aegaeon/delivery.json <<'EOF'
${jsonencode({region = aws_region, issuer_host = issuer_host, issuer_url = issuer_url, trusted_proxies = trusted_proxies, server_secret_arn = server_secret_arn, server_secret_version = server_secret_version})}
EOF
chmod 0600 /etc/aegaeon/delivery.json

install -d -m 0700 /usr/local/lib/aegaeon/runtime_delivery

cat >/usr/local/lib/aegaeon/runtime_delivery/__init__.py <<'PYTHON'
${delivery_init~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/__init__.py

cat >/usr/local/lib/aegaeon/runtime_delivery/common.py <<'PYTHON'
${delivery_common~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/common.py

cat >/usr/local/lib/aegaeon/runtime_delivery/credentials.py <<'PYTHON'
${delivery_credentials~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/credentials.py

cat >/usr/local/lib/aegaeon/runtime_delivery/filesystem.py <<'PYTHON'
${delivery_filesystem~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/filesystem.py

cat >/usr/local/lib/aegaeon/runtime_delivery/artifacts.py <<'PYTHON'
${delivery_artifacts~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/artifacts.py

cat >/usr/local/lib/aegaeon/runtime_delivery/reports.py <<'PYTHON'
${delivery_reports~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/reports.py

cat >/usr/local/lib/aegaeon/runtime_delivery/metrics.py <<'PYTHON'
${delivery_metrics~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/metrics.py

cat >/usr/local/lib/aegaeon/runtime_delivery/orchestration.py <<'PYTHON'
${delivery_orchestration~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/orchestration.py

cat >/usr/local/bin/aegaeon-deliver-supplies <<'PYTHON'
${delivery_helper~}
PYTHON
chmod 0755 /usr/local/bin/aegaeon-deliver-supplies
/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies preflight-aws

cat >/etc/aegaeon/registry.json <<'EOF'
${jsonencode({AWS_REGION = aws_region, AWS_DEFAULT_REGION = aws_region, GHCR_AUTH_ENABLED = ghcr_auth_enabled ? "1" : "0", GHCR_USERNAME = ghcr_username, GHCR_TOKEN_SSM_PARAMETER_NAME = ghcr_token_ssm_parameter_name, GHCR_TOKEN_SECRETSMANAGER_SECRET_ID = ghcr_token_secretsmanager_secret})}
EOF
chmod 0600 /etc/aegaeon/registry.json

cat >/usr/local/bin/aegaeon-docker-login <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

IMAGE_REF="$${1:-}"
if [[ -z "$IMAGE_REF" ]]; then
  exit 0
fi

REGISTRY_VALUES="$(/usr/bin/python3 -I -B - <<'PYTHON'
import json
import os
import re
import stat
import sys

FIELDS = (
    "AWS_REGION", "AWS_DEFAULT_REGION", "GHCR_AUTH_ENABLED", "GHCR_USERNAME",
    "GHCR_TOKEN_SSM_PARAMETER_NAME", "GHCR_TOKEN_SECRETSMANAGER_SECRET_ID",
)

def unique(items):
    value = {}
    for key, item in items:
        if key in value:
            raise ValueError("duplicate field")
        value[key] = item
    return value

try:
    path = "/etc/aegaeon/registry.json"
    before = os.lstat(path)
    if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600 or before.st_size > 16384:
        raise ValueError("unsafe registry file")
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
        opened = os.fstat(stream.fileno())
        raw = stream.read(16385)
        after = os.fstat(stream.fileno())
    def identity(info):
        return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns, info.st_mode, info.st_uid, info.st_nlink)
    if len(raw) > 16384 or identity(before) != identity(opened) or identity(opened) != identity(after) or identity(before) != identity(os.lstat(path)):
        raise ValueError("registry file changed")
    values = json.loads(raw, object_pairs_hook=unique)
    if type(values) is not dict or set(values) != set(FIELDS):
        raise ValueError("registry schema")
    for value in values.values():
        if type(value) is not str or len(value.encode("utf-8")) > 4096 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in value):
            raise ValueError("registry field")
    if values["GHCR_AUTH_ENABLED"] not in {"0", "1"} or not re.fullmatch("[a-z0-9-]+", values["AWS_REGION"]) or values["AWS_REGION"] != values["AWS_DEFAULT_REGION"]:
        raise ValueError("registry domain")
    print("\n".join([*(values[name] for name in FIELDS), "REGISTRY_JSON_END"]))
except (OSError, ValueError, TypeError, UnicodeError):
    print("[aegaeon] registry configuration validation failed", file=sys.stderr)
    raise SystemExit(1)
PYTHON
)"
mapfile -t REGISTRY_FIELDS <<<"$REGISTRY_VALUES"
if [[ "$${#REGISTRY_FIELDS[@]}" != 7 || "$${REGISTRY_FIELDS[6]}" != "REGISTRY_JSON_END" ]]; then
  echo "[aegaeon] registry configuration validation failed" >&2
  exit 1
fi
AWS_REGION="$${REGISTRY_FIELDS[0]}"
AWS_DEFAULT_REGION="$${REGISTRY_FIELDS[1]}"
GHCR_AUTH_ENABLED="$${REGISTRY_FIELDS[2]}"
GHCR_USERNAME="$${REGISTRY_FIELDS[3]}"
GHCR_TOKEN_SSM_PARAMETER_NAME="$${REGISTRY_FIELDS[4]}"
GHCR_TOKEN_SECRETSMANAGER_SECRET_ID="$${REGISTRY_FIELDS[5]}"
export AWS_REGION AWS_DEFAULT_REGION

REGISTRY="$(echo "$IMAGE_REF" | cut -d/ -f1)"
if [[ "$REGISTRY" != "ghcr.io" ]]; then
  exit 0
fi

if [[ "$${GHCR_AUTH_ENABLED:-0}" != "1" ]]; then
  exit 0
fi

if [[ -z "$${GHCR_USERNAME:-}" && -z "$${GHCR_TOKEN_SSM_PARAMETER_NAME:-}" && -z "$${GHCR_TOKEN_SECRETSMANAGER_SECRET_ID:-}" ]]; then
  exit 0
fi

if [[ -z "$${GHCR_USERNAME:-}" ]]; then
  echo "[aegaeon] GHCR auth enabled but GHCR_USERNAME is empty" >&2
  exit 1
fi

region="$AWS_REGION"
if [[ -z "$region" ]]; then
  echo "[aegaeon] failed to detect AWS region for GHCR token retrieval" >&2
  exit 1
fi

if [[ -n "$${GHCR_TOKEN_SSM_PARAMETER_NAME:-}" ]]; then
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
    aws ssm get-parameter \
      --with-decryption \
      --name "$GHCR_TOKEN_SSM_PARAMETER_NAME" \
      --query 'Parameter.Value' \
      --output text \
    | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
  exit 0
fi

if [[ -n "$${GHCR_TOKEN_SECRETSMANAGER_SECRET_ID:-}" ]]; then
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
    aws secretsmanager get-secret-value \
      --secret-id "$GHCR_TOKEN_SECRETSMANAGER_SECRET_ID" \
      --query 'SecretString' \
      --output text \
    | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
  exit 0
fi

echo "[aegaeon] GHCR auth enabled but no token source is configured (set GHCR_TOKEN_SSM_PARAMETER_NAME or GHCR_TOKEN_SECRETSMANAGER_SECRET_ID)" >&2
exit 1
EOF

chmod +x /usr/local/bin/aegaeon-docker-login

cat >/etc/systemd/system/aegaeon-server.service <<'EOF'
[Unit]
Description=Aegaeon server (container)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
LimitNOFILE=1048576
RuntimeDirectory=aegaeon-docker
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/aegaeon-docker

ExecStartPre=/usr/bin/bash -lc 'if systemctl cat docker.service >/dev/null 2>&1; then systemctl start docker.service; fi'
ExecStartPre=-/usr/bin/docker rm -f aegaeon-server
ExecStartPre=/usr/local/bin/aegaeon-docker-login ${server_image}
ExecStartPre=/usr/bin/docker pull ${server_image}
ExecStartPre=/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies server
ExecStart=/usr/bin/docker run --rm --name aegaeon-server --network host --env-file /run/aegaeon-supplies/server.env --entrypoint ${server_entrypoint} ${server_image} --host 0.0.0.0 --port ${server_port}
ExecStop=-/usr/bin/docker stop aegaeon-server

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now aegaeon-server.service
