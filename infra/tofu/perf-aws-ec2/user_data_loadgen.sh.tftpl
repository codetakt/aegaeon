#!/usr/bin/env bash

set -euo pipefail

exec > >(tee /var/log/aegaeon-user-data.log | logger -t aegaeon-user-data -s 2>/dev/console) 2>&1

echo "[aegaeon-user-data] starting loadgen bootstrap at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

install -d -m 0700 /etc/aegaeon
mkdir -p /opt/aegaeon/results
chmod 0700 /opt/aegaeon/results

dnf_install() {
  local -a packages=("$@")
  local attempts=5
  local delay_secs=5

  for attempt in $(seq 1 "$attempts"); do
    if dnf install -y "$${packages[@]}"; then
      return 0
    fi
    echo "[aegaeon-user-data] dnf install failed (attempt $${attempt}/$${attempts}); retrying in $${delay_secs}s..." >&2
    sleep "$delay_secs"
  done

  return 1
}

if ! command -v curl >/dev/null 2>&1; then
  dnf_install curl || dnf_install curl-minimal
fi

if [[ ! -x /usr/bin/python3 ]]; then
  dnf_install python3
fi

if [[ ! -x /usr/bin/aws ]]; then
  dnf_install awscli
fi

if ! command -v docker >/dev/null 2>&1; then
  if ! dnf_install docker; then
    dnf_install podman podman-docker
  fi
fi

systemctl enable --now amazon-ssm-agent || true
if systemctl cat docker.service >/dev/null 2>&1; then
  systemctl enable --now docker.service
fi

cat >/etc/aegaeon/loadtest.json <<'EOF'
${jsonencode({SERVER_URL = server_url, SERVER_IMAGE = server_image, ARTIFACT_BUCKET = artifact_bucket, ARTIFACT_PREFIX = artifact_prefix, WORKERS = tostring(workers), RPS = tostring(rps), RUN_TIME = run_time, WARMUP = tostring(warmup), SCENARIO = scenario, LOADTEST_BIN = loadgen_entrypoint, artifact = {receipt_path = loadgen_artifact_receipt_path, receipt_sha256 = loadgen_artifact_receipt_sha256, source_manifest_path = loadgen_source_manifest_path, source_manifest_sha256 = loadgen_source_manifest_sha256, executable_sha256 = loadgen_executable_sha256}})}
EOF
chmod 0600 /etc/aegaeon/loadtest.json

cat >/etc/aegaeon/delivery.json <<'EOF'
${jsonencode({region = aws_region, issuer_url = issuer_url, client_secret_arn = client_secret_arn, client_secret_version = client_secret_version, metrics_secret_arn = metrics_secret_arn, metrics_secret_version = metrics_secret_version})}
EOF
chmod 0600 /etc/aegaeon/delivery.json

install -d -m 0700 /usr/local/lib/aegaeon/runtime_delivery

cat >/usr/local/lib/aegaeon/runtime_delivery/__init__.py <<'PYTHON'
${delivery_init~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/__init__.py

cat >/usr/local/lib/aegaeon/runtime_delivery/common.py <<'PYTHON'
${delivery_common~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/common.py

cat >/usr/local/lib/aegaeon/runtime_delivery/credentials.py <<'PYTHON'
${delivery_credentials~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/credentials.py

cat >/usr/local/lib/aegaeon/runtime_delivery/filesystem.py <<'PYTHON'
${delivery_filesystem~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/filesystem.py

cat >/usr/local/lib/aegaeon/runtime_delivery/artifacts.py <<'PYTHON'
${delivery_artifacts~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/artifacts.py

cat >/usr/local/lib/aegaeon/runtime_delivery/reports.py <<'PYTHON'
${delivery_reports~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/reports.py

cat >/usr/local/lib/aegaeon/runtime_delivery/metrics.py <<'PYTHON'
${delivery_metrics~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/metrics.py

cat >/usr/local/lib/aegaeon/runtime_delivery/orchestration.py <<'PYTHON'
${delivery_orchestration~}
PYTHON
chmod 0400 /usr/local/lib/aegaeon/runtime_delivery/orchestration.py

cat >/usr/local/bin/aegaeon-deliver-supplies <<'PYTHON'
${delivery_helper~}
PYTHON
chmod 0755 /usr/local/bin/aegaeon-deliver-supplies
/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies preflight-aws

cat >/etc/aegaeon/registry.json <<'EOF'
${jsonencode({AWS_REGION = aws_region, AWS_DEFAULT_REGION = aws_region, GHCR_AUTH_ENABLED = ghcr_auth_enabled ? "1" : "0", GHCR_USERNAME = ghcr_username, GHCR_TOKEN_SSM_PARAMETER_NAME = ghcr_token_ssm_parameter_name, GHCR_TOKEN_SECRETSMANAGER_SECRET_ID = ghcr_token_secretsmanager_secret})}
EOF
chmod 0600 /etc/aegaeon/registry.json

cat >/usr/local/bin/aegaeon-docker-login <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

IMAGE_REF="$${1:-}"
if [[ -z "$IMAGE_REF" ]]; then
  exit 0
fi

REGISTRY_VALUES="$(/usr/bin/python3 -I -B - <<'PYTHON'
import json
import os
import re
import stat
import sys

FIELDS = (
    "AWS_REGION", "AWS_DEFAULT_REGION", "GHCR_AUTH_ENABLED", "GHCR_USERNAME",
    "GHCR_TOKEN_SSM_PARAMETER_NAME", "GHCR_TOKEN_SECRETSMANAGER_SECRET_ID",
)

def unique(items):
    value = {}
    for key, item in items:
        if key in value:
            raise ValueError("duplicate field")
        value[key] = item
    return value

try:
    path = "/etc/aegaeon/registry.json"
    before = os.lstat(path)
    if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600 or before.st_size > 16384:
        raise ValueError("unsafe registry file")
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
        opened = os.fstat(stream.fileno())
        raw = stream.read(16385)
        after = os.fstat(stream.fileno())
    def identity(info):
        return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns, info.st_mode, info.st_uid, info.st_nlink)
    if len(raw) > 16384 or identity(before) != identity(opened) or identity(opened) != identity(after) or identity(before) != identity(os.lstat(path)):
        raise ValueError("registry file changed")
    values = json.loads(raw, object_pairs_hook=unique)
    if type(values) is not dict or set(values) != set(FIELDS):
        raise ValueError("registry schema")
    for value in values.values():
        if type(value) is not str or len(value.encode("utf-8")) > 4096 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in value):
            raise ValueError("registry field")
    if values["GHCR_AUTH_ENABLED"] not in {"0", "1"} or not re.fullmatch("[a-z0-9-]+", values["AWS_REGION"]) or values["AWS_REGION"] != values["AWS_DEFAULT_REGION"]:
        raise ValueError("registry domain")
    print("\n".join([*(values[name] for name in FIELDS), "REGISTRY_JSON_END"]))
except (OSError, ValueError, TypeError, UnicodeError):
    print("[aegaeon] registry configuration validation failed", file=sys.stderr)
    raise SystemExit(1)
PYTHON
)"
mapfile -t REGISTRY_FIELDS <<<"$REGISTRY_VALUES"
if [[ "$${#REGISTRY_FIELDS[@]}" != 7 || "$${REGISTRY_FIELDS[6]}" != "REGISTRY_JSON_END" ]]; then
  echo "[aegaeon] registry configuration validation failed" >&2
  exit 1
fi
AWS_REGION="$${REGISTRY_FIELDS[0]}"
AWS_DEFAULT_REGION="$${REGISTRY_FIELDS[1]}"
GHCR_AUTH_ENABLED="$${REGISTRY_FIELDS[2]}"
GHCR_USERNAME="$${REGISTRY_FIELDS[3]}"
GHCR_TOKEN_SSM_PARAMETER_NAME="$${REGISTRY_FIELDS[4]}"
GHCR_TOKEN_SECRETSMANAGER_SECRET_ID="$${REGISTRY_FIELDS[5]}"
export AWS_REGION AWS_DEFAULT_REGION

REGISTRY="$(echo "$IMAGE_REF" | cut -d/ -f1)"
if [[ "$REGISTRY" != "ghcr.io" ]]; then
  exit 0
fi

if [[ "$${GHCR_AUTH_ENABLED:-0}" != "1" ]]; then
  exit 0
fi

if [[ -z "$${GHCR_USERNAME:-}" && -z "$${GHCR_TOKEN_SSM_PARAMETER_NAME:-}" && -z "$${GHCR_TOKEN_SECRETSMANAGER_SECRET_ID:-}" ]]; then
  exit 0
fi

if [[ -z "$${GHCR_USERNAME:-}" ]]; then
  echo "[aegaeon] GHCR auth enabled but GHCR_USERNAME is empty" >&2
  exit 1
fi

region="$AWS_REGION"
if [[ -z "$region" ]]; then
  echo "[aegaeon] failed to detect AWS region for GHCR token retrieval" >&2
  exit 1
fi

if [[ -n "$${GHCR_TOKEN_SSM_PARAMETER_NAME:-}" ]]; then
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
    aws ssm get-parameter \
      --with-decryption \
      --name "$GHCR_TOKEN_SSM_PARAMETER_NAME" \
      --query 'Parameter.Value' \
      --output text \
    | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
  exit 0
fi

if [[ -n "$${GHCR_TOKEN_SECRETSMANAGER_SECRET_ID:-}" ]]; then
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
    aws secretsmanager get-secret-value \
      --secret-id "$GHCR_TOKEN_SECRETSMANAGER_SECRET_ID" \
      --query 'SecretString' \
      --output text \
    | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
  exit 0
fi

echo "[aegaeon] GHCR auth enabled but no token source is configured (set GHCR_TOKEN_SSM_PARAMETER_NAME or GHCR_TOKEN_SECRETSMANAGER_SECRET_ID)" >&2
exit 1
EOF

chmod +x /usr/local/bin/aegaeon-docker-login

cat >/usr/local/bin/aegaeon-run-loadtest <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

umask 077
CONFIG_FILE=/etc/aegaeon/loadtest.json
if [[ "$#" -ne 0 ]]; then
  if [[ "$#" -ne 2 || "$1" != "--config-file" ]]; then
    echo "[perf] expected --config-file absolute-path" >&2
    exit 2
  fi
  CONFIG_FILE="$2"
fi

CONTAINER_ARGS=()
if [[ -v AEGAEON_SWEEP_ID ]]; then
  if [[ ! "$AEGAEON_SWEEP_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
    echo "[perf] invalid sweep UUID" >&2
    exit 2
  fi
  CONTAINER_ARGS=(--name "aegaeon-sweep-$AEGAEON_SWEEP_ID")
fi

/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies prepare-driver
exec 9>/run/aegaeon-supplies/driver.lock
flock -x 9

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$(cat /proc/sys/kernel/random/uuid)"
OUT_DIR="/opt/aegaeon/results/$${RUN_ID}"
mkdir -m 0700 "$${OUT_DIR}"
REPORT_DIR="$${OUT_DIR}/workload"
mkdir -m 0700 "$${REPORT_DIR}"
SUPPLY_PARENT="/run/aegaeon-supplies/$${RUN_ID}"
mkdir -m 0700 "$${SUPPLY_PARENT}"
SUPPLY_DIR="$${SUPPLY_PARENT}/inputs"
trap 'rm -rf -- "$${SUPPLY_PARENT}"' EXIT
export DOCKER_CONFIG="$${SUPPLY_PARENT}/docker"
mkdir -m 0700 "$${DOCKER_CONFIG}"

/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies run-config "$CONFIG_FILE" "$OUT_DIR"
while IFS='=' read -r name value; do
  case "$name" in
    SERVER_URL|SERVER_IMAGE|ARTIFACT_BUCKET|ARTIFACT_PREFIX|WORKERS|RPS|RUN_TIME|WARMUP|SCENARIO|LOADTEST_BIN|SOURCE_SHA256|EXECUTABLE_SHA256)
      printf -v "$name" '%s' "$value"
      ;;
    *) echo "[perf] invalid validated configuration output" >&2; exit 1 ;;
  esac
done <"$${OUT_DIR}/validated-config.env"
if [[ -e "$${OUT_DIR}/report.json" || -L "$${OUT_DIR}/report.json" ]]; then
  echo "[perf] report path already exists" >&2
  exit 1
fi

echo "[perf] waiting for server health at $${SERVER_URL%/}/health..."
HEALTH_READY=0
for _ in $(seq 1 120); do
  if curl -fsS "$${SERVER_URL%/}/health" >/dev/null 2>&1; then
    HEALTH_READY=1
    break
  fi
  sleep 1
done
if [[ "$HEALTH_READY" != "1" ]]; then
  echo "[perf] server health did not become ready" >&2
  exit 1
fi

echo "[perf] pulling image $${SERVER_IMAGE}..."
/usr/local/bin/aegaeon-docker-login "$${SERVER_IMAGE}"
docker pull "$${SERVER_IMAGE}"

/usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies client "$SUPPLY_DIR" "$SOURCE_SHA256"

echo "[perf] running load test (scenario=$${SCENARIO}, workers=$${WORKERS}, rps=$${RPS}, run_time=$${RUN_TIME})..."
set +e
docker run --rm "$${CONTAINER_ARGS[@]}" \
  --network host \
  --user 0:0 \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --env-file "$${SUPPLY_DIR}/client.env" \
  --entrypoint "$${LOADTEST_BIN}" \
  -v "$${REPORT_DIR}:/results" \
  --mount "type=bind,src=$${SUPPLY_DIR}/profile.json,dst=/run/aegaeon-inputs/profile.json,readonly" \
  --mount "type=bind,src=$${SUPPLY_DIR}/session.txt,dst=/run/aegaeon-inputs/session.txt,readonly" \
  --mount "type=bind,src=$${SUPPLY_DIR}/session-provenance.json,dst=/run/aegaeon-inputs/session-provenance.json,readonly" \
  "$${SERVER_IMAGE}" \
  --url "$${SERVER_URL}" \
  --workers "$${WORKERS}" \
  --run-time "$${RUN_TIME}" \
  --warmup "$${WARMUP}" \
  --rps "$${RPS}" \
  --scenario "$${SCENARIO}" \
  --report-file "/results/report.json" \
  >"$${OUT_DIR}/loadtest.stdout.log" 2>"$${OUT_DIR}/loadtest.stderr.log"
LOADTEST_EXIT_CODE="$?"
set -e

COLLECTION_FAILED=0
if ! printf '%s\n' "$${LOADTEST_EXIT_CODE}" >"$${OUT_DIR}/exit_code.txt"; then
  COLLECTION_FAILED=1
fi
if [[ ! -f "$${REPORT_DIR}/report.json" ]]; then
  echo "[perf] load test failed before producing report.json (exit_code=$${LOADTEST_EXIT_CODE})" >&2
  COLLECTION_FAILED=1
fi

if ! /usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies verify-report "$OUT_DIR" "$SUPPLY_DIR" "$RUN_ID"; then
  echo "[perf] report identity/configuration binding failed; preserving available outputs" >&2
  COLLECTION_FAILED=1
fi
if [[ -f "$${SUPPLY_DIR}/client.version.json" ]]; then
  cp "$${SUPPLY_DIR}/client.version.json" "$${OUT_DIR}/client.version.json" || COLLECTION_FAILED=1
fi

if ! /usr/bin/python3 -I -B /usr/local/bin/aegaeon-deliver-supplies metrics "$${OUT_DIR}"; then
  echo "[perf] metrics collection failed; preserving available outputs" >&2
  COLLECTION_FAILED=1
fi

for artifact in report.json loadtest.stdout.log loadtest.stderr.log exit_code.txt metrics-status.json run-receipt.json client.version.json driver-config.json artifact-receipt.json SOURCE-MANIFEST.json; do
  if [[ ! -f "$${OUT_DIR}/$${artifact}" ]]; then
    echo "[perf] required output missing: $${artifact}" >&2
    COLLECTION_FAILED=1
  fi
done

if [[ -n "$${ARTIFACT_BUCKET}" ]]; then
  DEST_PREFIX="s3://$${ARTIFACT_BUCKET}/$${ARTIFACT_PREFIX}$${RUN_ID}/"
  echo "[perf] uploading artifacts to $${DEST_PREFIX}..."
  for artifact in report.json loadtest.stdout.log loadtest.stderr.log exit_code.txt metrics-status.json run-receipt.json client.version.json driver-config.json artifact-receipt.json SOURCE-MANIFEST.json; do
    if [[ -f "$${OUT_DIR}/$${artifact}" ]]; then
      if ! aws s3 cp "$${OUT_DIR}/$${artifact}" "$${DEST_PREFIX}$${artifact}"; then
        COLLECTION_FAILED=1
      fi
    fi
  done
  if [[ -f "$${OUT_DIR}/server.metrics.prom" ]]; then
    if ! aws s3 cp "$${OUT_DIR}/server.metrics.prom" "$${DEST_PREFIX}server.metrics.prom"; then
      COLLECTION_FAILED=1
    fi
  fi
fi

echo "RUN_ID=$${RUN_ID}"
echo "EXIT_CODE=$${LOADTEST_EXIT_CODE}"
echo "OUT_DIR=$${OUT_DIR}"

if [[ "$${LOADTEST_EXIT_CODE}" -ne 0 ]]; then
  echo "[perf] load test returned non-zero (exit_code=$${LOADTEST_EXIT_CODE}); available outputs were preserved" >&2
  exit "$${LOADTEST_EXIT_CODE}"
fi
if [[ "$${COLLECTION_FAILED}" -ne 0 ]]; then
  echo "[perf] required output collection incomplete; available outputs were preserved" >&2
  exit 1
fi

echo "[perf] done; local results at $${OUT_DIR}"
exit 0
EOF

chmod +x /usr/local/bin/aegaeon-run-loadtest

cat >/etc/systemd/system/aegaeon-loadtest.service <<'EOF'
[Unit]
Description=Aegaeon load test (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/bash -lc 'if systemctl cat docker.service >/dev/null 2>&1; then systemctl start docker.service; fi'
ExecStart=/usr/local/bin/aegaeon-run-loadtest

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

%{ if auto_run_loadtest }
systemctl start aegaeon-loadtest.service
%{ endif }
