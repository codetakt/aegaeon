# Build artifacts
target/
c/**/*.o
c/**/*.a
c/**/*.so
c/**/*.dylib
c/**/*.dll
*.exe

# Generated files
# EverParse generated artefacts are checked in for CI reproducibility.
# Keep only transient build outputs ignored.
/generated/everparse/*.checked
/generated/everparse/krmlargs*.rsp
/generated/lowstar/oidc/*
!/generated/lowstar/oidc/hash/
!/generated/lowstar/oidc/hash/*.c
!/generated/lowstar/oidc/hash/*.h
!/generated/lowstar/oidc/id_token/
!/generated/lowstar/oidc/id_token/*.c
!/generated/lowstar/oidc/id_token/*.h
/generated/lowstar/verified-core/*
!/generated/lowstar/verified-core/verified_core.abi.json

# F* outputs
*.checked
*.hints
!FStar.Base64.fst.hints
!Spec.Hash.Definitions.fst.hints
*.ml
*.krml

# Rust
# Cargo.lock is now tracked for dependency management and security scanning
# Cargo.lock
**/*.rs.bk

# Vendored third-party sources (do not commit)
/crates/vendor/

# Local verification artefacts (curated ones are source-managed)
/artifacts/*
!/artifacts/release/
/artifacts/release/*
!/artifacts/release/kms-hsm-classifications/
!/artifacts/release/kms-hsm-classifications/*.json
!/artifacts/release/kms-hsm-classifications/evidence/
!/artifacts/release/kms-hsm-classifications/evidence/**/*.json
!/artifacts/release/kms-hsm-classifications/evidence/**/*.txt
!/artifacts/release/kms-hsm-classifications/evidence/**/*.log
!/artifacts/conformance/
/artifacts/conformance/*
!/artifacts/conformance/.gitkeep
!/artifacts/conformance/bootstrap/
/artifacts/conformance/bootstrap/*
!/artifacts/conformance/bootstrap/.gitkeep
/security-artifacts/
/result-server

# Dev-tools local outputs
/dev-tools/*/artifacts/

# Fuzz outputs
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/corpus_meta/
/fuzz/corpus_archive/
/fuzz/target/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.bak
*.log
reports/
dep.graph
verification_log.txt

# Coverage reports
*.lcov
*.gcov
*.gcda
*.gcno

# Security sensitive files
*.key
*.pem
!crates/server/tests/fixtures/*.pem
*.p12
*.pfx

# Local OIDF conformance TLS certificates (do not commit)
/scripts/oidf_conformance/certificates/

# Test outputs
test-results/
*.test

# Documentation build
/docs/_build/
/docs/_site/
# Documentation sources are tracked even when user-level ignores exclude Markdown.
!/docs/**/*.md

# The user-level core.excludesFile ignores Markdown. Re-include Markdown for
# this docs-heavy repository while keeping local agent instructions private.
!**/*.md
/AGENTS.md
/CLAUDE.md

# Python (for build scripts)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
venv/
env/

# SBOM and dependency tracking (generated under artifacts/)
*.cdx.json
crates/*/artifacts/

# cargo-vet cache (local)
.cargo-vet-cache/

# Local caches
.cache/
**/.cache_hint/
.deps/

# Local configuration overrides
*.local
.env.local

# Node
node_modules/

# Nix build outputs
result
result-*

# Nix direnv
.direnv/
.envrc

# git-hooks.nix (auto-generated by pre-commit install)
.pre-commit-config.yaml

# Temporary directories
tmp/
.kani-wrappers/

# act artifacts and environment
/.act-artifacts/
/.env.act
/.secrets
/.secrets.*
/.vars
/.vars.*
