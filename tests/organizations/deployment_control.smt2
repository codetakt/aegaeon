; Parent/child ownership invariant over arbitrary integer slot identifiers.
; This is a transition model, not a refinement proof for SQL, Rust, stores or
; supply. SQL linearization, exact generations, retained cleanup and nonrollback
; are premises that the actual implementation/composition must establish.
(set-option :timeout 10000)
(declare-const parents (Array Int Bool))
(declare-const generations (Array Int Int))
(declare-const children (Array Int Bool))
(declare-const owners (Array Int Int))
(declare-const child_generations (Array Int Int))
(declare-const p Int)
(declare-const c Int)
(define-fun invariant ((ps (Array Int Bool)) (gs (Array Int Int))
                      (cs (Array Int Bool)) (os (Array Int Int))
                      (cgs (Array Int Int))) Bool
 (forall ((i Int)) (=> (select cs i)
  (and (select ps (select os i))
       (= (select cgs i) (select gs (select os i)))))))
(assert (invariant parents generations children owners child_generations))

(echo "parent acquisition")
(push)
(assert (not (select parents p)))
(assert (not (invariant (store parents p true)
                       (store generations p (+ (select generations p) 1))
                       children owners child_generations)))
(check-sat)
(pop)

(echo "child acquisition")
(push)
(assert (select parents p))
(assert (not (select children c)))
(assert (not (invariant parents generations (store children c true)
                       (store owners c p)
                       (store child_generations c (select generations p)))))
(check-sat)
(pop)

(echo "child completion")
(push)
(assert (not (invariant parents generations (store children c false)
                       owners child_generations)))
(check-sat)
(pop)

(echo "parent completion")
(push)
(assert (forall ((i Int)) (not (and (select children i) (= (select owners i) p)
                                   (= (select child_generations i) (select generations p))))))
(assert (not (invariant (store parents p false) generations children owners child_generations)))
(check-sat)
(pop)

(echo "removed completion guard counterexample")
(push)
(assert (select children c))
(assert (= (select owners c) p))
(assert (not (invariant (store parents p false) generations children owners child_generations)))
(check-sat)
(pop)
