{
  "realm": "aegaeon",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "users": [
    {
      "username": "sdk-user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@example.com",
      "firstName": "SDK",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "browser-client",
      "name": "browser-client",
      "description": "Aegaeon SDK browser E2E client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "__KEYCLOAK_REDIRECT_URI__"
      ],
      "webOrigins": [
        "__KEYCLOAK_WEB_ORIGIN__"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__KEYCLOAK_POST_LOGOUT_REDIRECT_URI__"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles"
      ]
    }
  ]
}
