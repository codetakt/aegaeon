  "external_obligations": [
    {
      "id": "dudect",
      "owner": "Verification",
      "subject": "actual native ELF, product-call mapping, CPU and numerical profile",
      "required_evidence": [
        "all 21 cases and both compilers",
        "original raw0/101 controls and separate required sensitivity",
        "count/inference eligibility and retained detections",
        "full raw/input/prefix replay and capability confirmation"
      ],
      "entrypoints": [
        "scripts/ci/dudect_check.sh",
        "tests/constant_time/run_contract.py",
        "docs/verification/dudect-case-contract.md"
      ],
      "open_items": [
        "commission qualified external execution and protected result consumer",
        "review research candidate separately from existing observation contract"
      ]
    },
    {
      "id": "performance",
      "owner": "Performance",
      "subject": "server/image, load generator, topology and workload profile",
      "required_evidence": [
        "fixed successful scenario inventory and request accounting",
        "separate load generation and exclusive measurement lease",
        "DB/Redis/KMS/network versions and deployed runtime identity",
        "threshold acceptance and preserved failed/partial runs"
      ],
      "entrypoints": [
        ".github/workflows/performance.yml",
        "crates/loadtest/src/lib.rs",
        "scripts/perf/run_load_tests.sh"
      ],
      "open_items": [
        "commission external performance acceptance",
        "policy-mixed fixtures and execution remain pending"
      ]
    },
    {
      "id": "auth0",
      "owner": "Identity",
      "subject": "client/WASM/runtime, dedicated test tenant configuration and browser",
      "required_evidence": [
        "IaC ownership/readback before live execution",
        "actual required browser cases; no optional skip",
        "original observation time/producer/subject preserved on import",
        "bounded secret use, full recovery and owned resource cleanup"
      ],
      "entrypoints": [
        "scripts/sdk/tools-src/import-managed-provider-evidence.ts",
        "scripts/sdk/check_managed_provider_readiness.ts",
        "scripts/validation/validate_managed_provider_evidence.py"
      ],
      "open_items": [
        "propagate import fix to the separately maintained SDK repository",
        "bind IaC/live results to actual client artifact and tenant configuration",
        "authenticate original producer and observed_at separately from generated_at"
      ]
    },
    {
      "id": "kms",
      "owner": "Crypto and Operations",
      "subject": "real supported KMS/HSM backend and key/policy profile",
      "required_evidence": [
        "real backend distinguished from LocalStack",
        "required algorithms, permissions, rotation and failure behavior",
        "runtime dependency and key/policy identity; safe cleanup"
      ],
      "entrypoints": [
        ".github/workflows/oidc-kms-parity.yml",
        "scripts/validation/validate_kms_hsm_classification.py"
      ],
      "open_items": [
        "commission backend-specific qualification beyond emulator coverage"
      ]
    },
    {
      "id": "conformance",
      "owner": "Protocol verification",
      "subject": "pinned suite version, plans, parameter variants and actual result IDs",
      "required_evidence": [
        "nonempty complete configured inventory",
        "all required modules/variants and original dispositions",
        "notice jobs never substitute for execution or certification"
      ],
      "entrypoints": [
        ".github/workflows/oidf-conformance.yml",
        ".github/workflows/compliance.yml"
      ],
      "open_items": [
        "close suite discovery and canonical result correspondence"
      ]
    },
    {
      "id": "admission",
      "owner": "Release engineering",
      "subject": "reviewed merge candidate and exact distributable artifacts",
      "required_evidence": [
        "trusted producer authentication and request/subject/profile correspondence",
        "freshness policy and immutable original observations",
        "no missing, skipped, partial, failed or inconclusive required result",
        "merge-group and all publication routes consume protected decisions"
      ],
      "entrypoints": [
        ".github/workflows/pr.yml",
        ".github/workflows/release.yml",
        ".github/workflows/release-core.yml",
        ".github/workflows/docker-build.yml"
      ],
      "open_items": [
        "replace temporary merge/tag-release holds with verified receipts",
        "audit verified-core draft/SDK dispatch and container publication separately",
        "review all required subject dependency/freshness policies"
      ]
    },
    {
      "id": "measurement-lifecycle",
      "owner": "Operations",
      "subject": "owned finite execution with independent stop and encrypted recovery",
      "required_evidence": [
        "fixed inventory, cost/time/capacity limits and exclusive lease",
        "independent deadline stop; no retry or replacement",
        "authenticated complete/partial recovery and hash verification",
        "cleanup evidence for owned transient resources"
      ],
      "entrypoints": [
        "docs/development/ci-execution-boundary.md"
      ],
      "open_items": [
        "generalize finite research runner into reviewed production orchestration"
      ]
    }
  ]
}
