# Environment file template for `act` (local GitHub Actions runner).
#
# Usage:
#   cp .env.act.example .env.act
#
# NOTE: `.env.act` is gitignored. Do not commit secrets.

# Signals (keep these enabled so CI guardrails behave similarly to GitHub Actions).
ACT=true
CI=true
GITHUB_ACTIONS=true

# Optional: override GitHub context values (act normally populates these).
# GITHUB_REPOSITORY=aegaeon/aegaeon
# GITHUB_REF=refs/heads/main
# GITHUB_SHA=0000000000000000000000000000000000000000
# GITHUB_WORKFLOW=CI
# GITHUB_ACTOR=act-user

# Optional: override runner context values.
# RUNNER_OS=Linux
# RUNNER_ARCH=X64

# Secrets: pass via `act -s NAME=value` or `act --secret-file .secrets`.
# - GITHUB_TOKEN (required for workflows that reference `secrets.GITHUB_TOKEN`, e.g. GHCR login/push)
# - DOCKER_USERNAME / DOCKER_PASSWORD (only if a workflow uses them explicitly)
# - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN (only if needed)
# - CODECOV_TOKEN / AEGAEON_CARGO_REGISTRY_TOKEN (only if needed)
