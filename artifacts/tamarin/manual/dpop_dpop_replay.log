lemma dpop_replay_impossible:
  all-traces
  "∀ t n pk #i #j.
    ((ResourceGranted( t, n, pk ) @ #i) ∧
     (ResourceGranted( t, n, pk ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t n pk #i #j.
  (ResourceGranted( t, n, pk ) @ #i) ∧ (ResourceGranted( t, n, pk ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  by solve( SecChannel( 'client', 'resource_server', <$T, n, sign(n, x)>
            ) ▶₀ #i )
next
  case case_2
  by solve( SecChannel( 'client', 'resource_server', <$T, n, sign(n, x)>
            ) ▶₀ #i )
qed

