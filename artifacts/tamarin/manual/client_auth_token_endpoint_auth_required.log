theory TokenEndpointAuthRequired begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





rule (modulo E) RegisterConfidentialClient:
   [ Fr( ~client ) ]
  --[ ConfidentialRegistered( ~client ), ConfidentialMarked( ~client ) ]->
   [ !Confidential( ~client ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ClientRequestsToken:
   [ ] --[ TokenReq( $C, $Grant, $Auth ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) TokenGranting:
   [ !Confidential( $C ) ]
  --[
  TokenReq( $C, $Grant, $Auth ), ValidAuth( $C, $Auth ),
  TokenGranted( $C, $Grant, $Auth )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) InferBasicValidAuth:
   [ ] --[ TokenReq( $C, $Grant, 'basic' ) ]-> [ ValidAuth( $C, 'basic' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) InferPostValidAuth:
   [ ] --[ TokenReq( $C, $Grant, 'post' ) ]-> [ ValidAuth( $C, 'post' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) InferPkjwtValidAuth:
   [ ] --[ TokenReq( $C, $Grant, 'pkjwt' ) ]-> [ ValidAuth( $C, 'pkjwt' ) ]

  /* has exactly the trivial AC variant */

lemma TokenAuth:
  all-traces
  "∀ C Grant Auth #i #j #k.
    (((ConfidentialMarked( C ) @ #i) ∧ (TokenReq( C, Grant, Auth ) @ #j)) ∧
     (TokenGranted( C, Grant, Auth ) @ #k)) ⇒
    (∃ #m. ValidAuth( C, Auth ) @ #m)"
