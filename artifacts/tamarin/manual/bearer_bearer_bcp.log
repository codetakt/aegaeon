lemma no_access_after_revocation:
  all-traces
  "∀ token client user #i #j.
    ((Token_Revoked( token ) @ #i) ∧
     (Resource_Access_Granted( client, user, token, 'DPoP' ) @ #j)) ⇒
    (#j < #i)"
/*
guarded formula characterizing all counter-examples:
"∃ token client user #i #j.
  (Token_Revoked( token ) @ #i) ∧
  (Resource_Access_Granted( client, user, token, 'DPoP' ) @ #j)
 ∧
  ¬(#j < #i)"
*/
simplify
solve( Token_State( token, 'active' ) ▶₀ #i )
  case AS_Issue_Token_DPoP
  solve( !Bearer_Token( <'bearer', ~token_id, $C, $U,
                         'openid_profile_email', $issuer, 'resource_api', ~jti>,
                        $C.1, $U.1, issuer.1, audience, iat, exp, dpop_jkt
         ) ▶₁ #j )
    case AS_Issue_Token_DPoP
    by solve( Token_State( <'bearer', ~token_id, $C, $U,
                            'openid_profile_email', $issuer, 'resource_api', ~jti>,
                           'active'
              ) ▶₂ #j )
  qed
qed

