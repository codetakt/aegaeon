lemma jwt_bearer_grant_integrity:
  all-traces
  "∀ as client sub jti #i.
    (JwtBearerTokenIssued( as, client, sub, jti ) @ #i) ⇒
    (∃ #j. (JwtBearerRequest( client, as, sub, jti ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ as client sub jti #i.
  (JwtBearerTokenIssued( as, client, sub, jti ) @ #i)
 ∧
  ∀ #j. (JwtBearerRequest( client, as, sub, jti ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
  case Register_Client
  solve( UsedJti( $Client, jti ) ▶₂ #i )
    case Client_Issues_JwtBearer_Assertion
    solve( !KU( sign(<'jwt_bearer', $Client, $AS, sub, ~jti>, ~sk_client)
           ) @ #vk.12 )
      case Client_Issues_JwtBearer_Assertion
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~sk_client ) @ #vk.13 )
    qed
  qed
qed

lemma jwt_bearer_unforgeability:
  all-traces
  "∀ as client sub jti #i.
    (JwtBearerAccepted( as, client, sub, jti ) @ #i) ⇒
    (∃ pk #j. (ClientRegistered( client, pk ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ as client sub jti #i.
  (JwtBearerAccepted( as, client, sub, jti ) @ #i)
 ∧
  ∀ pk #j. (ClientRegistered( client, pk ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
  case Register_Client
  by contradiction /* from formulas */
qed

lemma jwt_bearer_no_replay:
  all-traces
  "∀ as client sub1 sub2 jti #i #j.
    ((JwtBearerTokenIssued( as, client, sub1, jti ) @ #i) ∧
     (JwtBearerTokenIssued( as, client, sub2, jti ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ as client sub1 sub2 jti #i #j.
  (JwtBearerTokenIssued( as, client, sub1, jti ) @ #i) ∧
  (JwtBearerTokenIssued( as, client, sub2, jti ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
    case Register_Client
    solve( UsedJti( $Client, jti ) ▶₂ #i )
      case Client_Issues_JwtBearer_Assertion
      solve( !ClientPK( $Client, pk(x) ) ▶₁ #j )
        case Register_Client
        solve( UsedJti( $Client, ~jti ) ▶₂ #j )
          case Client_Issues_JwtBearer_Assertion
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
    case Register_Client
    solve( UsedJti( $Client, jti ) ▶₂ #i )
      case Client_Issues_JwtBearer_Assertion
      solve( !ClientPK( $Client, pk(x) ) ▶₁ #j )
        case Register_Client
        solve( UsedJti( $Client, ~jti ) ▶₂ #j )
          case Client_Issues_JwtBearer_Assertion
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

















