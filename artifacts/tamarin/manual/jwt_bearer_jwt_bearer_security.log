   [
   Out( <$Client, $AS, <'jwt_bearer', $Client, $AS, ~sub, ~jti>,
         sign(<'jwt_bearer', $Client, $AS, ~sub, ~jti>, sk_client)>
   ),
   UsedJti( $Client, ~jti )
   ]

  /* has exactly the trivial AC variant */

