restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Unique:
  "∀ x #i #j. ((Unique( x ) @ #i) ∧ (Unique( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_Client:
   [ Fr( ~sk_client ) ]
  --[ ClientRegistered( $Client, pk(~sk_client) ) ]->
   [
   !ClientSK( $Client, ~sk_client ), !ClientPK( $Client, pk(~sk_client) ),
   Out( $Client ), Out( pk(~sk_client) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Issues_JwtBearer_Assertion:
   [ !ClientSK( $Client, sk_client ), Fr( ~sub ), Fr( ~jti ) ]
