theory AuthorizeSuccessRedirect begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





rule (modulo E) ClientMakesAuthzReq:
   [ Fr( ~s ), Fr( ~tid ) ]
  --[ AuthzReq( $C, $RU, ~s, ~tid ) ]->
   [ Req( $C, $RU, ~s, ~tid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerIssuesCodeAndRedirect:
   [ Req( $C, $RU, $S, $TID ), Fr( ~code ) ]
  --[
  CodeIssued( $C, ~code, $S, $RU, $TID ),
  Redirect( $C, $RU, ~code, $S, $TID )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma SuccessStateEcho:
  all-traces
  "∀ C RU S tid code #i #j.
    ((AuthzReq( C, RU, S, tid ) @ #i) ∧
     (Redirect( C, RU, code, S, tid ) @ #j)) ⇒
    (#i < #j)"
/*
guarded formula characterizing all counter-examples:
"∃ C RU S tid code #i #j.
  (AuthzReq( C, RU, S, tid ) @ #i) ∧ (Redirect( C, RU, code, S, tid ) @ #j)
 ∧
  ¬(#i < #j)"
*/
by simplify

lemma CodeFreshAndBound:
  all-traces
  "∀ C RU S code tid #i #j.
    ((CodeIssued( C, code, S, RU, tid ) @ #i) ∧
     (Redirect( C, RU, code, S, tid ) @ #j)) ⇒
    (#i < #j)"
/*
guarded formula characterizing all counter-examples:
"∃ C RU S code tid #i #j.
  (CodeIssued( C, code, S, RU, tid ) @ #i) ∧
  (Redirect( C, RU, code, S, tid ) @ #j)
 ∧
  ¬(#i < #j)"
*/
simplify
by solve( Req( $C, $RU, $S, $TID ) ▶₀ #i )

lemma RedirectRequiresRequest:
  all-traces
  "∀ C RU S tid code #j.
    (Redirect( C, RU, code, S, tid ) @ #j) ⇒
    (∃ #i. (AuthzReq( C, RU, S, tid ) @ #i) ∧ (#i < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C RU S tid code #j.
  (Redirect( C, RU, code, S, tid ) @ #j)
 ∧
  ∀ #i. (AuthzReq( C, RU, S, tid ) @ #i) ⇒ ¬(#i < #j)"
*/
simplify
by solve( Req( $C, $RU, $S, $TID ) ▶₀ #j )

lemma CodeIssuedUnique:
  all-traces
  "∀ C1 C2 RU1 RU2 S1 S2 T1 T2 code #i #j.
    ((CodeIssued( C1, code, S1, RU1, T1 ) @ #i) ∧
     (CodeIssued( C2, code, S2, RU2, T2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ C1 C2 RU1 RU2 S1 S2 T1 T2 code #i #j.
  (CodeIssued( C1, code, S1, RU1, T1 ) @ #i) ∧
  (CodeIssued( C2, code, S2, RU2, T2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
by contradiction /* from formulas */







