theory PKCE_Security begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







rule (modulo E) Authorization:
   [ Fr( c ), Fr( v ) ]
  --[ CodeIssued( c ), ChallengeStored( c, h(v) ) ]->
   [ Out( c ), !Challenge( c, h(v) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Token:
   [ In( <c, ver> ), !Challenge( c, h(ver) ) ]
  --[ TokenRequest( c, ver ), TokenIssued( c ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma mismatched_verifiers_cannot_inject_codes:
  all-traces
  "∀ c hv ver #i #j #k.
    ((((CodeIssued( c ) @ #i) ∧ (ChallengeStored( c, hv ) @ #i)) ∧
      (TokenRequest( c, ver ) @ #j)) ∧
     (TokenIssued( c ) @ #k)) ⇒
    (hv = h(ver))"
/*
guarded formula characterizing all counter-examples:
"∃ c hv ver #i #j #k.
  (CodeIssued( c ) @ #i) ∧
  (ChallengeStored( c, hv ) @ #i) ∧
  (TokenRequest( c, ver ) @ #j) ∧
  (TokenIssued( c ) @ #k)
 ∧
  ¬(hv = h(ver))"
*/
simplify
solve( !Challenge( ~n, h(ver) ) ▶₁ #j )
  case Authorization
  by contradiction /* from formulas */
qed









