theory StepUpSoundness begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





rule (modulo E) StepUpRequired:
   [ Fr( ~req ) ]
  --[ StepUpRequired( $Client, ~req ) ]->
   [ StepUpReq( $Client, ~req ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) IssueChallenge:
   [ StepUpReq( C, req ), Fr( ~challenge ) ]
  --[ ChallengeIssued( C, req, ~challenge ) ]->
   [ Challenge( C, req, ~challenge ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteChallenge:
   [ Challenge( C, req, challenge ) ]
  --[ ChallengeCompleted( C, req, challenge ) ]->
   [ StepUpCompleted( C, req ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) TokenIssuedAfterStepUp:
   [ StepUpReq( C, req ), StepUpCompleted( C, req ), Fr( ~token ) ]
  --[ TokenIssued( C, req, ~token ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) TokenIssuedWithoutStepUp:
   [ Fr( ~req ), Fr( ~token ) ]
  --[ TokenIssuedNoStepUp( $Client, ~req, ~token ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma stepup_soundness:
  all-traces
  "∀ C req tok #i #j.
    ((StepUpRequired( C, req ) @ #j) ∧ (TokenIssued( C, req, tok ) @ #i)) ⇒
    (∃ ch #k.
      ((ChallengeCompleted( C, req, ch ) @ #k) ∧ (#j < #k)) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ C req tok #i #j.
  (StepUpRequired( C, req ) @ #j) ∧ (TokenIssued( C, req, tok ) @ #i)
 ∧
  ∀ ch #k.
   (ChallengeCompleted( C, req, ch ) @ #k) ⇒ ((¬(#j < #k)) ∨ (¬(#k < #i)))"
*/
simplify
solve( StepUpReq( $Client, ~req ) ▶₀ #i )
  case StepUpRequired
  by solve( StepUpCompleted( $Client, ~req ) ▶₁ #i )
qed







