lemma session_integrity:
  all-traces
  "∀ user client state nonce token #i.
    (SessionComplete( user, client, state, nonce, token ) @ #i) ⇒
    (∃ #k. (UserAuthorizes( user, client, state, nonce ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ user client state nonce token #i.
  (SessionComplete( user, client, state, nonce, token ) @ #i)
 ∧
  ∀ #k. (UserAuthorizes( user, client, state, nonce ) @ #k) ⇒ ¬(#k < #i)"
*/
simplify
solve( UserSession( $User, $Client, state, nonce, code_verifier ) ▶₁ #i )
  case User_Authorize
  by contradiction /* from formulas */
qed

