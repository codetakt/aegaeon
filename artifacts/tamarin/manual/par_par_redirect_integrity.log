 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( PARRequestSent( $Client, $AS, state, code_challenge, $RedirectURI
         ) ▶₀ #i )
    case PAR_Request
    solve( !AS( $AS, sk_as ) ▶₃ #i )
      case Register_AS
      solve( !StoredPAR( uri, $AS, $Client, ~state, h(~code_verifier),
                         $RedirectURI
             ) ▶₄ #i )
        case AS_Process_PAR
        solve( PARRequestSent( $Client, $AS, state.1, code_challenge,
                               $RedirectURI.1
               ) ▶₀ #j )
          case PAR_Request
          solve( !AS( $AS, sk_as.1 ) ▶₃ #j )
            case Register_AS
            solve( !StoredPAR( ~request_uri, $AS, $Client, ~state.1,
                               h(~code_verifier.1), $RedirectURI.1
                   ) ▶₄ #j )
              case AS_Process_PAR
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( PARRequestSent( $Client, $AS, state, code_challenge, $RedirectURI
         ) ▶₀ #i )
    case PAR_Request
    solve( !AS( $AS, sk_as ) ▶₃ #i )
      case Register_AS
      solve( !StoredPAR( uri, $AS, $Client, ~state, h(~code_verifier),
                         $RedirectURI
             ) ▶₄ #i )
        case AS_Process_PAR
        solve( PARRequestSent( $Client, $AS, state.1, code_challenge,
                               $RedirectURI.1
               ) ▶₀ #j )
          case PAR_Request
          solve( !AS( $AS, sk_as.1 ) ▶₃ #j )
            case Register_AS
            solve( !StoredPAR( ~request_uri, $AS, $Client, ~state.1,
                               h(~code_verifier.1), $RedirectURI.1
                   ) ▶₄ #j )
              case AS_Process_PAR
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
qed

