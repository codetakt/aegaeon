lemma redirect_integrity:
  all-traces
  "∀ as client code #i.
    (CodeIssued( as, client, code ) @ #i) ⇒
    (∃ secret redirect_uri state #j.
      ((ClientRegistered( client, as, secret, redirect_uri ) @ #j) ∧
       (AuthorizationWithPAR( as, client, state, code, redirect_uri ) @ #i)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ as client code #i.
  (CodeIssued( as, client, code ) @ #i)
 ∧
  ∀ secret redirect_uri state #j.
   (ClientRegistered( client, as, secret, redirect_uri ) @ #j) ∧
   (AuthorizationWithPAR( as, client, state, code, redirect_uri ) @ #i)
  ⇒
   ¬(#j < #i)"
*/
simplify
solve( PARRequestSent( $Client, $AS, state, code_challenge, $RedirectURI
       ) ▶₀ #i )
  case PAR_Request
  by contradiction /* from formulas */
qed

lemma request_uri_single_use:
  all-traces
  "∀ as client uri code1 code2 #i #j.
    ((UserAuthorized( as, client, uri, code1 ) @ #i) ∧
