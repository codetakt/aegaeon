rule (modulo E) Register_Client:
   [ Fr( ~client_secret ) ]
  --[ ClientRegistered( $Client, $AS, ~client_secret, $RedirectURI ) ]->
   [
   !Client( $Client, $AS, ~client_secret, $RedirectURI ), Out( $Client ),
