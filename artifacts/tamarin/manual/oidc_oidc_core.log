lemma auth_code_single_use:
  all-traces
  "∀ op code rp #i #j.
    ((Code_Used( op, code, rp ) @ #i) ∧ (Code_Used( op, code, rp ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ op code rp #i #j.
  (Code_Used( op, code, rp ) @ #i) ∧ (Code_Used( op, code, rp ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Auth_Code( $OP, code, rp, $User, nonce,
                    h(<'S256', code_verifier>), redirect_uri, auth_time
         ) ▶₁ #i )
    case User_Authenticate
    solve( !OP_Key( $OP, op_key ) ▶₂ #i )
      case OP_Init
      solve( !OP_Issuer( $OP, issuer ) ▶₃ #i )
        case OP_Init
        solve( !Pk( $RP, rp_pk ) ▶₄ #i )
          case Register_pk
          solve( Auth_Code( $OP, ~code, $RP, $User.1, nonce.1,
                            h(<'S256', code_verifier.1>), redirect_uri.1, auth_time
                 ) ▶₁ #j )
            case User_Authenticate
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( Auth_Code( $OP, code, rp, $User, nonce,
                    h(<'S256', code_verifier>), redirect_uri, auth_time
         ) ▶₁ #i )
    case User_Authenticate
    solve( !OP_Key( $OP, op_key ) ▶₂ #i )
      case OP_Init
      solve( !OP_Issuer( $OP, issuer ) ▶₃ #i )
        case OP_Init
        solve( !Pk( $RP, rp_pk ) ▶₄ #i )
          case Register_pk
          solve( Auth_Code( $OP, ~code, $RP, $User.1, nonce.1,
                            h(<'S256', code_verifier.1>), redirect_uri.1, auth_time
                 ) ▶₁ #j )
            case User_Authenticate
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
qed

