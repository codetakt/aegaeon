rule (modulo E) Register_pk:
   [ Fr( ~sk ) ] --> [ !Ltk( $A, ~sk ), !Pk( $A, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_ltk:
   [ !Ltk( A, sk ) ] --[ Reveal( A ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OP_Init:
   [ Fr( ~op_key ) ]
  --[ OP_Initialized( $OP, <'https', $OP, $domain> ) ]->
   [
   !OP_Key( $OP, ~op_key ), !OP_Issuer( $OP, <'https', $OP, $domain> ),
   Out( <$OP, 'https', $OP, $domain> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Register:
   [ !OP_Key( $OP, op_key ), !Ltk( $RP, rp_sk ), !Pk( $RP, pk(rp_sk) ) ]
  --[ RP_Registered( $OP, $RP, $redirect_uri, $client_secret ) ]->
   [
   !RP( $OP, $RP, $redirect_uri, $client_secret ),
   !RP_RedirectURI( $RP, $redirect_uri )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Start_Auth:
   [
   Fr( ~nonce ), Fr( ~state ), Fr( ~code_verifier ),
   !RP( $OP, $RP, redirect_uri, client_secret )
   ]
  --[
  RP_Auth_Started( $RP, $User, ~nonce, ~state, h(<'S256', ~code_verifier>)
  )
  ]->
   [
   Out( <'auth_request', $RP, redirect_uri, 'openid', ~state, ~nonce,
         h(<'S256', ~code_verifier>), 'code'>
   ),
   RP_Session( $RP, $User, ~nonce, ~state, ~code_verifier, redirect_uri )
   ]

  /* has exactly the trivial AC variant */

