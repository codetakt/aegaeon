lemma session_integrity:
  all-traces
  "∀ rp user nonce1 state challenge claims nonce2 #i #j.
    ((RP_Auth_Started( rp, user, nonce1, state, challenge ) @ #i) ∧
     (ID_Token_Verified( rp, user, claims, nonce2 ) @ #j)) ⇒
    (nonce1 = nonce2)"
/*
guarded formula characterizing all counter-examples:
"∃ rp user nonce1 state challenge claims nonce2 #i #j.
  (RP_Auth_Started( rp, user, nonce1, state, challenge ) @ #i) ∧
  (ID_Token_Verified( rp, user, claims, nonce2 ) @ #j)
 ∧
  ¬(nonce1 = nonce2)"
*/
simplify
solve( !RP( $OP, $RP, redirect_uri, client_secret ) ▶₃ #i )
  case RP_Register
  solve( !Ltk( $RP, rp_sk ) ▶₁ #j )
    case Register_pk
    solve( RP_Session( $RP, $User, nonce2, state.1, code_verifier.1,
                       redirect_uri.1
           ) ▶₂ #j )
      case RP_Start_Auth
      solve( !StoredIDToken( id_token, $OP.1, $RP, $User, issuer, ~nonce.1,
                             auth_time, h(access_token), exp_time, iat_time, op_key, access_token
             ) ▶₃ #j )
        case OP_Issue_Tokens
        by solve( !Pk( $OP.1, pk(~op_key) ) ▶₄ #j )
      qed
    qed
  qed
qed

