lemma par_authorization_details_used:
  all-traces
  "∀ sid details #i.
    ((AuthDetailsSelected( sid, details ) @ #i) ∧ (ParUsed( sid ) @ #i)) ⇒
    (∃ #j. ParStored( sid, details ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ sid details #i.
  (AuthDetailsSelected( sid, details ) @ #i) ∧ (ParUsed( sid ) @ #i)
 ∧
  ∀ #j. (ParStored( sid, details ) @ #j) ⇒ ⊥"
*/
simplify
solve( AuthDetailsSelected( sid, details ) @ #i )
  case Authorize_Direct_Form
  by solve( ParUsed( ~sid ) @ #i )
next
  case Authorize_Direct_Query
  by solve( ParUsed( ~sid ) @ #i )
next
  case Authorize_Direct_RequestObject
  by solve( ParUsed( ~sid ) @ #i )
next
  case Authorize_Direct_RequestObject_Overrides_Form
  by solve( ParUsed( ~sid ) @ #i )
next
  case Authorize_Direct_RequestObject_Overrides_Query
  by solve( ParUsed( ~sid ) @ #i )
next
  case Authorize_With_PAR_And_Query
  solve( !ParAuthDetails( sid, details ) ▶₀ #i )
    case Par_Submit_Form
    by contradiction /* from formulas */
  next
    case Par_Submit_RequestObject
    by contradiction /* from formulas */
  next
    case Par_Submit_RequestObject_Overrides_Form
    by contradiction /* from formulas */
  qed
next
  case Authorize_With_PAR_NoQuery
  solve( !ParAuthDetails( sid, details ) ▶₀ #i )
    case Par_Submit_Form
    by contradiction /* from formulas */
  next
    case Par_Submit_RequestObject
    by contradiction /* from formulas */
  next
    case Par_Submit_RequestObject_Overrides_Form
    by contradiction /* from formulas */
  qed
qed

