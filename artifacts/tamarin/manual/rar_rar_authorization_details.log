rule (modulo E) Client_Authenticate:
   [ Fr( ~sid ) ] --[ ClientAuthenticated( ~sid ) ]-> [ ClientAuth( ~sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Par_Submit_RequestObject:
   [ ClientAuth( sid ), Fr( ~ro_details ) ]
  --[
  ParSubmission( sid ), RequestObjectProvided( sid, ~ro_details ),
  ParStored( sid, ~ro_details )
  ]->
   [ !ParAuthDetails( sid, ~ro_details ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Par_Submit_Form:
   [ ClientAuth( sid ), In( form_details ) ]
  --[
  ParSubmission( sid ), FormProvided( sid, form_details ),
  FormInjected( sid, form_details ), ParStored( sid, form_details )
  ]->
   [ !ParAuthDetails( sid, form_details ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Par_Submit_RequestObject_Overrides_Form:
   [ ClientAuth( sid ), Fr( ~ro_details ), In( form_details ) ]
  --[
  ParSubmission( sid ), RequestObjectProvided( sid, ~ro_details ),
  FormProvided( sid, form_details ), FormInjected( sid, form_details ),
  ParStored( sid, ~ro_details )
  ]->
   [ !ParAuthDetails( sid, ~ro_details ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Authorize_With_PAR_NoQuery:
   [ !ParAuthDetails( sid, details ) ]
  --[ ParUsed( sid ), AuthDetailsSelected( sid, details ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Authorize_With_PAR_And_Query:
   [ !ParAuthDetails( sid, details ), In( query_details ) ]
  --[
  ParUsed( sid ), QueryProvided( sid, query_details ),
  QueryInjected( sid, query_details ), AuthDetailsSelected( sid, details )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

