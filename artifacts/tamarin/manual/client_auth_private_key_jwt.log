lemma pkjwt_no_replay:
  all-traces
  "∀ as client jti #i #j.
    ((TokenIssued( as, client, jti ) @ #i) ∧
     (TokenIssued( as, client, jti ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ as client jti #i #j.
  (TokenIssued( as, client, jti ) @ #i) ∧
  (TokenIssued( as, client, jti ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
    case Register_Client
    solve( UsedJti( $Client, jti ) ▶₂ #i )
      case Client_Issues_Pkjwt_Assertion
      solve( !ClientPK( $Client, pk(x) ) ▶₁ #j )
        case Register_Client
        solve( UsedJti( $Client, ~jti ) ▶₂ #j )
          case Client_Issues_Pkjwt_Assertion
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
    case Register_Client
    solve( UsedJti( $Client, jti ) ▶₂ #i )
      case Client_Issues_Pkjwt_Assertion
      solve( !ClientPK( $Client, pk(x) ) ▶₁ #j )
        case Register_Client
        solve( UsedJti( $Client, ~jti ) ▶₂ #j )
          case Client_Issues_Pkjwt_Assertion
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

















