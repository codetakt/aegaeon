lemma pkjwt_client_auth_integrity:
  all-traces
  "∀ as client jti #i.
    (TokenIssued( as, client, jti ) @ #i) ⇒
    (∃ #j. (PkjwtRequest( client, as, jti ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ as client jti #i.
  (TokenIssued( as, client, jti ) @ #i)
 ∧
  ∀ #j. (PkjwtRequest( client, as, jti ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !ClientPK( $Client, pk(x) ) ▶₁ #i )
  case Register_Client
  solve( UsedJti( $Client, jti ) ▶₂ #i )
    case Client_Issues_Pkjwt_Assertion
    solve( !KU( sign(<'pkjwt', $Client, $AS, ~jti>, ~sk_client) ) @ #vk.10 )
      case Client_Issues_Pkjwt_Assertion
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~sk_client ) @ #vk.11 )
    qed
  qed
qed

