theory RevocationAuth begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2









rule (modulo E) Issue_Token:
   [ Fr( ~token ) ]
  --[ TokenIssued( $AS, $Client, ~token ) ]->
   [ !Token( $AS, $Client, ~token ), !TokenOwner( ~token, $Client ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Revoke:
   [ !Token( $AS, client_id, token ), !TokenOwner( token, client_id ) ]
  --[ RevocationRequested( client_id, token ) ]->
   [ Out( <'revoke', token, client_id> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AS_Revoke:
   [
   In( <'revoke', token, client_id> ), !Token( $AS, client_id, token ),
   !TokenOwner( token, client_id )
   ]
  --[ TokenRevoked( $AS, client_id, token ) ]->
   [ RevokedToken( token ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Unauthorized_Revoke:
   [ In( token ), Fr( ~attacker_id ) ]
  --[ UnauthorizedRevocation( ~attacker_id, token ) ]->
   [ Out( <'revoke', token, ~attacker_id> ) ]

  /* has exactly the trivial AC variant */

lemma authorized_revocation:
  all-traces
  "∀ AS cid token #i.
    (TokenRevoked( AS, cid, token ) @ #i) ⇒
    (∃ #j. (TokenIssued( AS, cid, token ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ AS cid token #i.
  (TokenRevoked( AS, cid, token ) @ #i)
 ∧
  ∀ #j. (TokenIssued( AS, cid, token ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !Token( $AS, cid, token ) ▶₁ #i )
  case Issue_Token
  by contradiction /* from formulas */
qed

lemma revocation_authorization:
  all-traces
  "∀ AS cid1 cid2 token #i #j.
    ((TokenIssued( AS, cid1, token ) @ #i) ∧
     (TokenRevoked( AS, cid2, token ) @ #j)) ⇒
    (cid1 = cid2)"
/*
guarded formula characterizing all counter-examples:
"∃ AS cid1 cid2 token #i #j.
  (TokenIssued( AS, cid1, token ) @ #i) ∧
  (TokenRevoked( AS, cid2, token ) @ #j)
 ∧
  ¬(cid1 = cid2)"
*/
simplify
solve( !Token( $AS, cid2, ~token ) ▶₁ #j )
  case Issue_Token
  by contradiction /* from formulas */
qed













