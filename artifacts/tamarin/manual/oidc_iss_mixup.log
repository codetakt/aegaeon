theory IssuerMixup begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, sign/2, snd/1,
           true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true











restriction Once:
  "∀ x #i #j. ((Once( x ) @ #i) ∧ (Once( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Unique:
  "∀ x #i #j. ((Unique( x ) @ #i) ∧ (Unique( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) AS_Setup:
   [ Fr( ~sk_as ) ]
  --[ ASRegistered( $AS, pk(~sk_as) ) ]->
   [ !AS( $AS, ~sk_as ), !ASPubKey( $AS, pk(~sk_as) ), Out( pk(~sk_as) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Register:
   [ !ASPubKey( $AS, pk_as ), Fr( ~client_id ) ]
  --[ ClientRegisteredWith( $Client, $AS ), Once( $Client ) ]->
   [ !ClientAS( $Client, $AS, pk_as ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AS_Authorize:
   [ Fr( ~code ), !AS( $AS, sk_as ), !ClientAS( $Client, $AS, pk(sk_as) ) ]
  --[
  AuthorizedBy( $AS, $Client ), CodeIssued( $AS, $Client, ~code ),
  Unique( <'code', ~code> )
  ]->
   [
   Out( <~code, $AS, sign(<~code, $AS>, sk_as)> ),
   !IssuedCode( ~code, $AS, $Client )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Validate_Issuer:
   [
   !ClientAS( $Client, $AS, pk_as ), In( <code, issuer, sig> ),
   !IssuedCode( code, $AS, $Client )
   ]
  --[
  Eq( issuer, $AS ), Eq( verify(sig, <code, issuer>, pk_as), true ),
  IssuerValidated( $Client, $AS, code )
  ]->
   [ ValidCode( $Client, $AS, code ) ]

