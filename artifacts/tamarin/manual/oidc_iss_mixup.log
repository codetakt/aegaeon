  */

lemma no_issuer_mixup:
  all-traces
  "∀ C AS1 AS2 code #i #j.
    ((ClientRegisteredWith( C, AS1 ) @ #i) ∧
     (IssuerValidated( C, AS2, code ) @ #j)) ⇒
    (AS1 = AS2)"
/*
guarded formula characterizing all counter-examples:
"∃ C AS1 AS2 code #i #j.
  (ClientRegisteredWith( C, AS1 ) @ #i) ∧
  (IssuerValidated( C, AS2, code ) @ #j)
 ∧
  ¬(AS1 = AS2)"
*/
simplify
solve( !ASPubKey( $AS, pk_as ) ▶₀ #i )
  case AS_Setup
  solve( !ClientAS( $Client, $AS.1, pk(x) ) ▶₀ #j )
    case Client_Register
    by contradiction /* from formulas */
  qed
qed

lemma issuer_binding:
  all-traces
  "∀ C AS code #i.
    (IssuerValidated( C, AS, code ) @ #i) ⇒
    (∃ #j. (CodeIssued( AS, C, code ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ C AS code #i.
  (IssuerValidated( C, AS, code ) @ #i)
 ∧
  ∀ #j. (CodeIssued( AS, C, code ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !ClientAS( $Client, $AS, pk(x) ) ▶₀ #i )
  case Client_Register
  solve( !IssuedCode( code, $AS, $Client ) ▶₂ #i )
    case AS_Authorize
    by contradiction /* from formulas */
  qed
qed





















